function SetRaceAggression takes nothing returns nothing
  set b_race_aggression[0] = 2
  set b_race_aggression[1] = 3
  set b_race_aggression[2] = 4
  set b_race_aggression[3] = 1
  set b_race_aggression[4] = 3
  set b_race_aggression[5] = 5
  set b_race_aggression[6] = -1
  set b_race_aggression[7] = 0
  set b_race_aggression[8] = 1
  set b_race_aggression[9] = -1
  set b_race_aggression[10] = -1
  set b_race_aggression[11] = 2
endfunction

function AMAI_PickMeleeHero takes nothing returns nothing
  local integer i = 0
  //local location l = GetUnitLoc(nearest_neutral[NEUTRAL_TAVERN])

  set hero_number = race_hero_number + ver_neutral_hero_number
  // recalculate_heros occurs only if hero is a tavern hero but tavern is not pathable
  if not recalculate_heros and ver_neutral_heroes_available and neutral_available[NEUTRAL_TAVERN] then //and CanPathToLoc(home_location, l, PATHING_TYPE_WALKABILITY) > 0 then
    call InitNeutralSkills()
    //call Trace("PickMeleeHero: Neutral Hero possible")
  else
    set first_choosable_hero = ver_neutral_hero_number
  endif
  //call RemoveLocation(l)
  //set l = null

  set all_heroes[0] = uNAGA_SORCERESS
  set hero_rp[0] = 20
  set all_heroes[1] = uBEAST_MASTER
  set hero_rp[1] = 15
  set all_heroes[2] = uDARK_RANGER 
  set hero_rp[2] = 19
  set all_heroes[3] = uNEUTRAL_PIT_LORD 
  set hero_rp[3] = 10
  set all_heroes[4] = uBREW_MASTER 
  set hero_rp[4] = 12
  set all_heroes[5] = uGOBLIN_TINKER
  set hero_rp[5] = 10
  set all_heroes[6] = uFIRELORD
  set hero_rp[6] = 19
  set all_heroes[7] = uALCHEMIST
  set hero_rp[7] = 10
  set all_heroes[8] = uARCHMAGE
  set hero_rp[8] = 41
  set all_heroes[9] = uMTN_KING
  set hero_rp[9] = 30
  set all_heroes[10] = uPALADIN
  set hero_rp[10] = 18
  set all_heroes[11] = uBLOOD_MAGE
  set hero_rp[11] = 11


  loop
  exitwhen i > hero_number
    set all_heroes_copy[i] = all_heroes[i]
    set i = i + 1
  endloop

  call AddFavoriteHeroRP()
  call AddStrategyHeroRP(strategy_first_hero[strategy], strategy_first_hero_bonus[strategy])

  // increase the rp for those that are good for certain matchups

  if c_ally_total > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 0
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 10
  endif

  if c_enemy[R_RANDOM] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 0
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_enemy[R_ELF] > 0 then
    set hero_rp[0] = hero_rp[0] + 10
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 10
    set hero_rp[9] = hero_rp[9] + 10
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_ally[R_ELF] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 0
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_enemy[R_HUMAN] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 10
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_ally[R_HUMAN] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 0
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_enemy[R_ORC] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 10
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 10
    set hero_rp[9] = hero_rp[9] + 10
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_ally[R_ORC] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 0
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_enemy[R_UNDEAD] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 10
    set hero_rp[9] = hero_rp[9] + 10
    set hero_rp[10] = hero_rp[10] + 10
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_ally[R_UNDEAD] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 0
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif


  set hero_rp[0] = hero_rp[0] + -15
  set hero_rp[1] = hero_rp[1] + -4
  set hero_rp[2] = hero_rp[2] + -14
  set hero_rp[3] = hero_rp[3] + -8
  set hero_rp[4] = hero_rp[4] + -9
  set hero_rp[5] = hero_rp[5] + -4
  set hero_rp[6] = hero_rp[6] + -14
  set hero_rp[7] = hero_rp[7] + -3
  set hero_rp[8] = hero_rp[8] + 10
  set hero_rp[9] = hero_rp[9] + 0
  set hero_rp[10] = hero_rp[10] + -18
  set hero_rp[11] = hero_rp[11] + -11

  set picked_hero = ChooseFirstHero()

  set hero_rp[0] = hero_rp[0] - -15
  set hero_rp[1] = hero_rp[1] - -4
  set hero_rp[2] = hero_rp[2] - -14
  set hero_rp[3] = hero_rp[3] - -8
  set hero_rp[4] = hero_rp[4] - -9
  set hero_rp[5] = hero_rp[5] - -4
  set hero_rp[6] = hero_rp[6] - -14
  set hero_rp[7] = hero_rp[7] - -3
  set hero_rp[8] = hero_rp[8] - 10
  set hero_rp[9] = hero_rp[9] - 0
  set hero_rp[10] = hero_rp[10] - -18
  set hero_rp[11] = hero_rp[11] - -11


  // increase the rp for those that are better as second or third hero
  set hero_rp[0] = hero_rp[0] + 5
  set hero_rp[1] = hero_rp[1] + -8
  set hero_rp[2] = hero_rp[2] + -5
  set hero_rp[3] = hero_rp[3] + -2
  set hero_rp[4] = hero_rp[4] + 3
  set hero_rp[5] = hero_rp[5] + -1
  set hero_rp[6] = hero_rp[6] + -5
  set hero_rp[7] = hero_rp[7] + -1
  set hero_rp[8] = hero_rp[8] + 0
  set hero_rp[9] = hero_rp[9] + 0
  set hero_rp[10] = hero_rp[10] + 0
  set hero_rp[11] = hero_rp[11] + 0

  call AddStrategyHeroRP(strategy_second_hero[strategy], strategy_second_hero_bonus[strategy])
  call ChooseSecondHero()
  set hero_rp[0] = hero_rp[0] - 5
  set hero_rp[1] = hero_rp[1] - -8
  set hero_rp[2] = hero_rp[2] - -5
  set hero_rp[3] = hero_rp[3] - -2
  set hero_rp[4] = hero_rp[4] - 3
  set hero_rp[5] = hero_rp[5] - -1
  set hero_rp[6] = hero_rp[6] - -5
  set hero_rp[7] = hero_rp[7] - -1
  set hero_rp[8] = hero_rp[8] - 0
  set hero_rp[9] = hero_rp[9] - 0
  set hero_rp[10] = hero_rp[10] - 0
  set hero_rp[11] = hero_rp[11] - 0
  // ------------------------------------------------------------------------------

  set hero_rp[0] = hero_rp[0] + 0
  set hero_rp[1] = hero_rp[1] + -12
  set hero_rp[2] = hero_rp[2] + 0
  set hero_rp[3] = hero_rp[3] + 2
  set hero_rp[4] = hero_rp[4] + 6
  set hero_rp[5] = hero_rp[5] + 0
  set hero_rp[6] = hero_rp[6] + 0
  set hero_rp[7] = hero_rp[7] + 0
  set hero_rp[8] = hero_rp[8] + 0
  set hero_rp[9] = hero_rp[9] + 0
  set hero_rp[10] = hero_rp[10] + 18
  set hero_rp[11] = hero_rp[11] + 0

  call AddStrategyHeroRP(strategy_third_hero[strategy], strategy_third_hero_bonus[strategy])
  call ChooseRestHeroes()
endfunction






function airairBuild takes nothing returns nothing
  local integer cc_airair = 0

  set cc_airair = TownCount(uCOPTER)
  if cc_airair >= bn_airair then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_airair, uCOPTER, 90  )
  endif
endfunction
function airgroundBuild takes nothing returns nothing
  local integer cc_airground = 0

  set cc_airground = TownCount(uGRYPHON)
  if cc_airground >= bn_airground then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_airground, uGRYPHON, 90  )
  endif
endfunction
function groundairBuild takes nothing returns nothing
  local integer cc_groundair = 0

  set cc_groundair = TownCount(uRIFLEMAN)
  if cc_groundair >= bn_groundair then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_groundair, uRIFLEMAN, 90  )
  endif
endfunction
function groundgroundBuild takes nothing returns nothing
  local integer cc_groundground = 0

  set cc_groundground = TownCount(uFOOTMAN)
  if cc_groundground >= bn_groundground then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_groundground, uFOOTMAN, 90  )
  endif
endfunction
function farmBuild takes nothing returns nothing
  local integer cc_farm = 0

  set cc_farm = TownCount(uHOUSE)
  if cc_farm >= bn_farm then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_farm, uHOUSE, 90  )
  endif
endfunction
function guardBuild takes nothing returns nothing
  local integer cc_guard = 0

  set cc_guard = TownCount(uGUARD_TOWER)
  if cc_guard >= bn_guard then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_guard, uGUARD_TOWER, 90  )
  endif
endfunction

function cmdBuild takes nothing returns nothing
  if false then
  elseif strategy == 50 then
    call airairBuild()
  elseif strategy == 51 then
    call airgroundBuild()
  elseif strategy == 52 then
    call groundairBuild()
  elseif strategy == 53 then
    call groundgroundBuild()
  elseif strategy == 54 then
    call farmBuild()
  elseif strategy == 55 then
    call guardBuild()
  endif
endfunction

function set_skills takes nothing returns nothing
    if hero[1]== uNAGA_SORCERESS then
        call LoadSkills(1,1,1)
    elseif hero[2]== uNAGA_SORCERESS then
        call LoadSkills(2,1,2)
    elseif hero[3]== uNAGA_SORCERESS then
        call LoadSkills(3,1,3)
    endif
    if hero[1]== uBEAST_MASTER then
        call LoadSkills(1,2,1)
    elseif hero[2]== uBEAST_MASTER then
        call LoadSkills(2,2,2)
    elseif hero[3]== uBEAST_MASTER then
        call LoadSkills(3,2,3)
    endif
    if hero[1]== uDARK_RANGER  then
        call LoadSkills(1,3,1)
    elseif hero[2]== uDARK_RANGER  then
        call LoadSkills(2,3,2)
    elseif hero[3]== uDARK_RANGER  then
        call LoadSkills(3,3,3)
    endif
    if hero[1]== uNEUTRAL_PIT_LORD  then
        call LoadSkills(1,4,1)
    elseif hero[2]== uNEUTRAL_PIT_LORD  then
        call LoadSkills(2,4,2)
    elseif hero[3]== uNEUTRAL_PIT_LORD  then
        call LoadSkills(3,4,3)
    endif
    if hero[1]== uBREW_MASTER  then
        call LoadSkills(1,5,1)
    elseif hero[2]== uBREW_MASTER  then
        call LoadSkills(2,5,2)
    elseif hero[3]== uBREW_MASTER  then
        call LoadSkills(3,5,3)
    endif
    if hero[1]== uGOBLIN_TINKER then
        call LoadSkills(1,6,1)
    elseif hero[2]== uGOBLIN_TINKER then
        call LoadSkills(2,6,2)
    elseif hero[3]== uGOBLIN_TINKER then
        call LoadSkills(3,6,3)
    endif
    if hero[1]== uFIRELORD then
        call LoadSkills(1,7,1)
    elseif hero[2]== uFIRELORD then
        call LoadSkills(2,7,2)
    elseif hero[3]== uFIRELORD then
        call LoadSkills(3,7,3)
    endif
    if hero[1]== uALCHEMIST then
        call LoadSkills(1,8,1)
    elseif hero[2]== uALCHEMIST then
        call LoadSkills(2,8,2)
    elseif hero[3]== uALCHEMIST then
        call LoadSkills(3,8,3)
    endif
    if hero[1]== uARCHMAGE then
        call LoadSkills(1,9,1)
    elseif hero[2]== uARCHMAGE then
        call LoadSkills(2,9,2)
    elseif hero[3]== uARCHMAGE then
        call LoadSkills(3,9,3)
    endif
    if hero[1]== uMTN_KING then
        call LoadSkills(1,10,1)
    elseif hero[2]== uMTN_KING then
        call LoadSkills(2,10,2)
    elseif hero[3]== uMTN_KING then
        call LoadSkills(3,10,3)
    endif
    if hero[1]== uPALADIN then
        call LoadSkills(1,11,1)
    elseif hero[2]== uPALADIN then
        call LoadSkills(2,11,2)
    elseif hero[3]== uPALADIN then
        call LoadSkills(3,11,3)
    endif
    if hero[1]== uBLOOD_MAGE then
        call LoadSkills(1,12,1)
    elseif hero[2]== uBLOOD_MAGE then
        call LoadSkills(2,12,2)
    elseif hero[3]== uBLOOD_MAGE then
        call LoadSkills(3,12,3)
    endif
endfunction

function setup_force takes boolean inj returns nothing

    set wave = wave + 1

    call InitAssaultGroup()

    if inj then
      call RemoveInjuries()
    endif

    call SetMeleeGroupAM( hero[1] )
    call SetMeleeGroupAM( hero[2] )
    call SetMeleeGroupAM( hero[3] )
    call SetMeleeGroupAM( uCOPTER )
    call SetMeleeGroupAM( uFOOTMAN )
    call SetMeleeGroupAM( uGRYPHON )
    call SetMeleeGroupAM( uKNIGHT )
    call SetMeleeGroupAM( uMORTAR )
    call SetMeleeGroupAM( uPRIEST )
    call SetMeleeGroupAM( uRIFLEMAN )
    call SetMeleeGroupAM( uSORCERESS )
    call SetMeleeGroupAM( uSTEAM_TANK )
    call SetMeleeGroupAM( uROCKET_TANK )
    call SetMeleeGroupAM( uSPELL_BREAKER )
    call SetMeleeGroupAM( uHUMAN_DRAGON_HAWK )
    call SetMeleeGroupAM( uGOBLIN_TINKER_M )
    call SetMeleeGroupAM( uALCHEMIST_M1 )
    call SetMeleeGroupAM( uALCHEMIST_M2 )
    call SetMeleeGroupAM( uALCHEMIST_M3 )
    call AttackGroupAddNeutrals()
    call AttackGroupAddUnknown()

endfunction



function basic_melee takes integer food, integer prio returns nothing
    call FoodPoolAM(food, true, race_simple_melee, GetFoodUsed(old_id[race_simple_melee]), CanBuildUnit(race_advanced_melee), race_advanced_melee, GetFoodUsed(old_id[race_advanced_melee]), prio)
endfunction

function setup_ghouls takes nothing returns nothing
  local integer gn = TownCountDone(racial_ghoul)
  local integer wood = GetWood()

  if wave <= 2 then
    set harvesting_ghouls = 1
  //elseif wave==2 then
    //set attacking_ghouls = Max(6, gn - 2)
  //elseif wood < maximum_peon_wood then
    //set attacking_ghouls = gn - Max((gn - 4) - (4 * TownCountDone(neutral_shredder)), 0)
    //set harvesting_ghouls = Max(0,Min(10 - wood / minimum_peon_wood,c_ghoul_done))
    //set attacking_ghouls = gn - (havesting_ghouls - (4 * TownCountDone(neutral_shredder))
  //elseif wood > maximum_peon_wood and wood < minimum_peon_wood / 2 then
    //set attacking_ghouls = gn - Max(2 - (4 * TownCountDone(neutral_shredder)), 0)
  elseif wave <= 4 then
    set harvesting_ghouls = Max(1,Min(R2I(race_min_ghouls*LinearInterpolation(maximum_peon_wood, minimum_peon_wood, 1, 0, wood) + 0.5),gn) - (R2I(shredder_peon_count/2) * TownCountDone(neutral_shredder)))
  else
    set harvesting_ghouls = Max(1,Min(R2I(race_max_ghouls*LinearInterpolation(maximum_peon_wood, minimum_peon_wood, 1, 0, wood) + 0.5),gn) - (R2I(shredder_peon_count/2) * TownCountDone(neutral_shredder)))
  endif
  //set attacking_ghouls = gn - harvesting_ghouls
  //set attacking_ghouls = Min(Max(attacking_ghouls, 0), gn)
  //call Trace("Attacking Ghouls:" + Int2Str(gn - harvesting_ghouls))
  call Trace("Harvesting Ghouls:" + Int2Str(harvesting_ghouls))
endfunction

//============================================================================
//  global builds
//============================================================================
function global_init_strategy takes nothing returns nothing
    call SetTierBlock(1, 0.5, 30, false)
    call SetTierBlock(2, 0.5, 45, false)
    if not IsMapFlagSet(MAP_RANDOM_HERO) then
      call AddBlock(1, uHUMAN_ALTAR, false, 0, uARCANE_VAULT, 16)
      call AddBlock(1, uHUMAN_ALTAR, false, 0, uHOUSE, 16)
      call AddBlock(1, uHUMAN_ALTAR, false, 0, uBARRACKS, 16)
    endif
    call AddBlock(2, uHOUSE, true, 0, uARCANE_VAULT, 36)
    call AddBlock(1, uBARRACKS, false, 0, uLUMBER_MILL, 20)
    call AddBlock(1, uBARRACKS, true, 0, uARCANE_VAULT, 36)
    call AddBlock(1, uBARRACKS, false, 0, uBLACKSMITH, 20)
    call AddBlock(1, uBLACKSMITH, false, 0, uWATCH_TOWER, 36)
    call AddHarass(1, 2, uFOOTMAN)
    call AddHarass(3, 2, uGRYPHON)
    call AddHarass(4, 1, uPALADIN)
    if militia_expanding or militia_state > 0 then
	call AddBlock(2, uTOWN_HALL, false, 0, uKEEP, 36)
    endif
































































endfunction
function global_build_sequence takes nothing returns nothing
      // Anti rush
      if GetRushFactor() < 5000 then
            call BuildUnit(2, uARCANE_TOWER, 60)
            call BuildAtMine(1, uGUARD_TOWER, 45)
      endif
      if GetGold() > 550 then
            call BuildFront(1, uGUARD_TOWER, 50)
            call BuildFront(1, uARCANE_TOWER, 45)
      endif  
      if GetGold() > 1000 then
            call BuildFront(2, uGUARD_TOWER, 30)  
      endif
      if HasExpanded() then
            call DefendTownsFrontDone(1, uGUARD_TOWER, 70)
            call DefendTownsFrontDone(2, uARCANE_TOWER, 75)
            if GetGold() > 2000 then
                  call DefendTownsFrontDone(3, uGUARD_TOWER, 35)
                  call DefendTownsFrontDone(2, uARCANE_TOWER, 35)
                  if tier >= 2 and TownCount(uGUARD_TOWER) >= 4 and TownCount(uARCANE_VAULT) < 2 then
                        call DefendTownsDone(1, uARCANE_VAULT, 40)
                  endif
            endif
      endif
      if TownCount(uWORKSHOP) >= 1 then
            call BuildFront(1, uCANNON_TOWER, 40)
      endif

      call BuildItem(1, uSCROLL_OF_REGENERATION, 90)
      call BuildItem(2, uSCROLL_OF_REGENERATION, 50)
      call BuildItem(1, uM_SCROLL_OF_HEALING, 40)

      call BuildItem(1, uSCROLL_OF_PROTECTION, 40)
      call BuildItem(1, uPOTION_OF_LESSER_INVULNERBILITY, 50)
      call BuildItem(1, uLESSER_CLARITY_POTION, 35)
      call BuildItem(1, uBOOTS_OF_SPEED, 50)
      if tier == 1 then
	      call BuildItem(1, uM_TOWN_PORTAL, 100)
      endif
      if tier > 1 then
            call BuildItem(1, uHEALING_POTION, 80)
            call BuildItem(1, uTOWN_PORTAL, 150)
      endif
      if tier >= 3 then
            call BuildItem(1, uSTAFF_OF_SANCTUARY, 70)
            if AatpAbility then // forwards compatability
                  call BuildItem(1, uORB_OF_SLOW, 60)
            endif
      endif

	call ResetDynamicSystem()
	if tier == 1 then
		call AddUnitToAntiair(uRIFLEMAN,29)
		call AddUnitToAnticasters(uRIFLEMAN,29)
		call AddUnitToAntitowers(uFOOTMAN,29)
		call AddUnitToAntipiercing(uFOOTMAN, 29)
		call AddUnitToAntinormal(uFOOTMAN, 1)
		call AddUnitToAntisiege(uRIFLEMAN,1)
		call AddUnitToAntisiege(uFOOTMAN,1)
		call AddUnitToAntimagic(uRIFLEMAN,29)
		call AddUnitToAntiunarmored(uRIFLEMAN,29)
		call AddUnitToAntilightarmor(uRIFLEMAN,29)
		call AddUnitToAntimediumarmor(uFOOTMAN,1)
		call AddUnitToAntiheavyarmor(uFOOTMAN,29)
		call DynamicBuildUnit(32, 40)
		call BuildUnit(1, merc_range, 65)
		call BuildUnit(1, merc_healer, 65)
	elseif tier == 2 then
		call AddUnitToAntiair(uRIFLEMAN,5)
		call AddUnitToAntiair(uCOPTER,2+GetUpgradeLevel(old_id[uUPG_FLAK]))
		call AddUnitToAntiair(uHUMAN_DRAGON_HAWK,5)
		call AddUnitToAnticasters(uSPELL_BREAKER,4+GetUpgradeLevel(old_id[uUPG_CONT_MAGIC]))
		call AddUnitToAnticasters(uPRIEST,GetUpgradeLevel(old_id[uUPG_PRAYING]))
		call AddUnitToAntitowers(uMORTAR,40)
		//call AddUnitToAntitowers(uHUMAN_DRAGON_HAWK,10)  // need tier 3 uUPG_CLOUD
		call AddUnitToAntipiercing(uSPELL_BREAKER, 7)
		call AddUnitToAntipiercing(uRIFLEMAN, 3)
		call AddUnitToAntinormal(uFOOTMAN, 1)
		call AddUnitToAntisiege(uRIFLEMAN,2)
		call AddUnitToAntisiege(uSPELL_BREAKER,1)
		call AddUnitToAntimagic(uRIFLEMAN,1)
		call AddUnitToAntimagic(uSPELL_BREAKER,3)
		call AddUnitToAntiunarmored(uRIFLEMAN,6)
		call AddUnitToAntiunarmored(uMORTAR,2)
		call AddUnitToAntiunarmored(uHUMAN_DRAGON_HAWK,2)
		call AddUnitToAntilightarmor(uRIFLEMAN,25)
		call AddUnitToAntilightarmor(uHUMAN_DRAGON_HAWK,25)
		call AddUnitToAntilightarmor(uSORCERESS,5)
		call AddUnitToAntilightarmor(uPRIEST,5)
		call AddUnitToAntimediumarmor(uFOOTMAN,1)
		call AddUnitToAntiheavyarmor(uSORCERESS,7)
		call AddUnitToAntiheavyarmor(uPRIEST,2)
		call DynamicBuildUnit(64, 40)
		call BuildUnit(1, dragons[3], 65)
		call BuildUnit(1, merc_range, 65)
	else
		call AddUnitToAntiair(uRIFLEMAN,5)
		call AddUnitToAntiair(uCOPTER,2+GetUpgradeLevel(old_id[uUPG_FLAK]))
		call AddUnitToAntiair(uHUMAN_DRAGON_HAWK,5)
		call AddUnitToAntiair(uROCKET_TANK,GetUpgradeLevel(old_id[uUPG_TANK]))
		call AddUnitToAnticasters(uSPELL_BREAKER,5)
		call AddUnitToAnticasters(uPRIEST,1)
		call AddUnitToAntitowers(uMORTAR,6)
		call AddUnitToAntitowers(uHUMAN_DRAGON_HAWK,1)
		if GetUpgradeLevel(uUPG_TANK) > 0 then
			call AddUnitToAntitowers(uROCKET_TANK,2)
		else
			call AddUnitToAntitowers(TANK,2)
		endif
		call AddUnitToAntitowers(uCOPTER,2*GetUpgradeLevel(old_id[uUPG_BOMBS]))
		call AddUnitToAntipiercing(uSPELL_BREAKER, 7)
		call AddUnitToAntipiercing(uRIFLEMAN, 3)
		call AddUnitToAntinormal(uKNIGHT, 9)
		call AddUnitToAntisiege(uRIFLEMAN,2)
		call AddUnitToAntisiege(uSPELL_BREAKER,1)
		call AddUnitToAntimagic(uRIFLEMAN,1)
		call AddUnitToAntimagic(uSPELL_BREAKER,3)
		call AddUnitToAntiunarmored(uRIFLEMAN,6)
		call AddUnitToAntiunarmored(uMORTAR,2)
		call AddUnitToAntiunarmored(uHUMAN_DRAGON_HAWK,2)
		call AddUnitToAntilightarmor(uRIFLEMAN,10)
		call AddUnitToAntilightarmor(uHUMAN_DRAGON_HAWK,10)
		call AddUnitToAntilightarmor(uSORCERESS,1)
		call AddUnitToAntilightarmor(uPRIEST,1)
		call AddUnitToAntilightarmor(uGRYPHON,2)
		call AddUnitToAntimediumarmor(uKNIGHT,7)
		call AddUnitToAntiheavyarmor(uSORCERESS,5)
		call AddUnitToAntiheavyarmor(uGRYPHON,10)
		call AddUnitToAntiheavyarmor(uPRIEST,1)
		call DynamicBuildUnit(100, 40)
		call BuildUnit(1, dragons[3], 65)
	endif

    // Global Upgrades

	// TIER 1 UPGRADES
	//--------------------------------------------------------
		if tier == 1 then
		endif
        	call BuildAdvUpgr2(1, uUPG_DEFEND, 1,TownCountDone(uFOOTMAN), 0.33, 15, 60)
		//if towerrush then
		//	call BuildUpgr(1, uUPG_MASONRY, 100)
		//endif		
		call BuildAdvUpgr(3, uUPG_MASONRY,1,1,1,5,20)
		call BuildAdvUpgr2(3, uUPG_MELEE, 1,TownCountDone(uFOOTMAN) + TownCountDone(uKNIGHT) + TownCountDone(uSPELL_BREAKER) + TownCountDone(uHUMAN_DRAGON_HAWK) + TownCountDone(uGRYPHON), 5,15,35)
		call BuildAdvUpgr2(3, uUPG_ARMOR, 1,TownCountDone(uFOOTMAN) + TownCountDone(uKNIGHT) + TownCountDone(uSPELL_BREAKER) + TownCountDone(uCOPTER) + TownCountDone(TANK), 5,15,35)
   		call BuildAdvUpgr2(3, uUPG_RANGED, 1,TownCountDone(uRIFLEMAN) + TownCountDone(uCOPTER) + TownCountDone(TANK) + TownCountDone(uMORTAR), 5,15,35)
  		call BuildAdvUpgr2(3, uUPG_LEATHER, 1,TownCountDone(uRIFLEMAN) + TownCountDone(uGRYPHON) + TownCountDone(uHUMAN_DRAGON_HAWK) + TownCountDone(uMORTAR), 5,15,35)

    // TIER 2 UPGRADES
    //--------------------------------------------------------
	if tier >= 2 then
		call BuildUnit(Max(2 - TownCountDone(merc_healer),0), uPRIEST, 40)
	   	call BuildUpgr(1, uUPG_WOOD, 40) 
	endif
		call BuildAdvUpgr2(1, uUPG_SENTINEL, 2, TownCountDone(uWATCH_TOWER) + c_enemy[R_ELF],2, 10, 25) 
		call BuildAdvUpgr2(1, uUPG_BOMBS, 2,TownCountDone(uCOPTER),1,10, 40)
        call BuildAdvUpgr2(1, uUPG_FLAK, 2,TownCountDone(uCOPTER),0.33,15, 40)
		call BuildAdvUpgr2(1, uUPG_GUN_RANGE, 2,TownCountDone(uRIFLEMAN),1,10, 40)
		call BuildAdvUpgr2(1, uUPG_CONT_MAGIC, 2,TownCountDone(uSPELL_BREAKER), 0.5, 10, 50)
		call BuildAdvUpgr2(1, uUPG_SIGHT, 2,TownCountDone(uMORTAR),1,10, 25)
		call BuildAdvUpgr2(2, uUPG_PRAYING, 2,TownCountDone(uPRIEST), 0.33, 15, 80)
		call BuildAdvUpgr2(2, uUPG_SORCERY,2,TownCountDone(uSORCERESS), 0.33, 15, 80)	

    // TIER 3 UPGRADES
    //--------------------------------------------------------
		if tier == 3 then
	   	call BuildUpgr(2, uUPG_WOOD, 40)
		endif
		call BuildAdvUpgr2(1, uUPG_FRAGS, 3,TownCountDone(uMORTAR), 0.33,15, 40)
		call BuildAdvUpgr2(1, uUPG_HAMMERS, 3,TownCountDone(uGRYPHON), 0.33,15, 60)
		call BuildAdvUpgr2(1, uUPG_BREEDING, 3,TownCountDone(uKNIGHT) + TownCountDone(uGRYPHON) + TownCountDone(uHUMAN_DRAGON_HAWK),1,15, 60)
		call BuildAdvUpgr2(1, uUPG_TANK, 3, TownCountDone(TANK),0.25,15, 50)

      // Global Mercenaries
        call BuildUnit(Max(2 - TownCountDone(uPRIEST),0), merc_healer, 40)
		

          // Harass
          call Harass(1, HARASS_TARGET_PEONS, true, 5, 0.75, 0, GetPlayerRace(nearest_enemy) != RACE_UNDEAD and TownCountDone(uFOOTMAN) > 6, 50, 80)
          call Harass(3, HARASS_TARGET_PEONS, true, 5, 0.75, 0, GetPlayerRace(nearest_enemy) != RACE_UNDEAD and TownCountDone(uGRYPHON) > 4, 80, 100)
          call Harass(4, HARASS_TARGET_PEONS, true, 4, 0.1, 0, GetPlayerRace(nearest_enemy) == RACE_UNDEAD and GetUnitCountDone(old_id[uPALADIN]) > 0 , 50, 80)
































































endfunction

//============================================================================
//  build_sequence
//============================================================================
function init_strategy_NormalHuman takes nothing returns nothing

    call AddHarass(2, 4, uFOOTMAN)
    call AddHarass(2, 1, uRIFLEMAN)
    set distraction_group = 2





















endfunction
function build_sequence_NormalHuman takes nothing returns nothing
if tier == 3 then

      call BuildUnit(3, uRIFLEMAN, 50)
      call BuildUnit(2, uMORTAR, 10)
      call BuildUnit(2, uCOPTER, 10)
      call BuildUnit(2, uHUMAN_DRAGON_HAWK, 40)
      call BuildUnit(2, uSPELL_BREAKER, 40)
      call BuildUnit(6, uKNIGHT, 55)
      call BuildUnit(7, uGRYPHON, 40)
      call BuildUnit(4, uRIFLEMAN, 50)
      call BuildUnit(3, uSORCERESS, 40)
      call BuildUnit(2, uPRIEST, 40)
      call BuildUnit(1, uCASTLE, 62)
      call BuildUnit(1, hero[1], 80)
      call BuildUnit(1, hero[2], 72)
      call BuildUnit(1, hero[3], 60)
      call BuildUnit(1, uARCANE_VAULT, 70)
      call BuildFront(1, uARCANE_TOWER, 55)
      call BuildUnit(1, uZEPPELIN, 50)

























elseif tier == 2 then

      call BuildUnit(1, hero[1], 80)
      call BuildUnit(8, uFOOTMAN, 65)
      call BuildUnit(4, uRIFLEMAN, 55)
      call BuildUnit(1, uARCANE_VAULT, 57)
      call BuildFront(1, uARCANE_TOWER, 57)
      call BuildUnit(1, hero[2], 72)
      call BuildUnit(2, uMORTAR, 45)
      call BuildUnit(1, uCASTLE, 62)




























else
// THIS IS REPLICA OF BLIZZARDS AI

        call BuildUnit(  1, hero[1], 80      )
        call BuildUnit(  8, uFOOTMAN , 65   )
        call BuildUnit(  3, uRIFLEMAN , 55    )
        call BuildUnit(  1, uARCANE_VAULT, 54 )
        call BasicExpansionAM( GetMinesOwned() < 2 ,uTOWN_HALL, 53)
        call BuildFront(1, uARCANE_TOWER, 45)
        call BuildUnit(  4, uRIFLEMAN, 43    )
        call BuildUnit(  1, uKEEP, 42        )























endif
endfunction

