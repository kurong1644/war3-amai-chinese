  set kb_add2 = 9
  set kb_add3 = 3
  set kb_add4 = 10
  set ku_add1 = 4
  set ku_add2 = 7
  set ku_add3 = 8
  set fav_unit_add = 20
  set debug_strategy = -1
  set race_use_fountain = true
  set race_manual_loading = false
  set race_manual_loading_wisp = 0
  set race_manual_loading_mine = 0
  set race_towerrush_available = false
  set race_tower_id = uWATCH_TOWER
  set race_tower_upgrade = uGUARD_TOWER
  set race_towerrush_probability = 28
  set race_militia_expansion_available = true
  set race_hero_number = 4
  set race_simple_melee = uFOOTMAN
  set race_advanced_melee = uKNIGHT
  set race_has_ghouls = false
  set race_ghouls_attack = true
  set race_has_power_build = true
  set race_no_wood_harvest = false
  set race_ignore_injured = false
  set race_uses_mine_expansion = false
  set race_uses_shredder = true
  set race_militia_available = true
  set race_militia_max_distance = 1000
  set race_militia_id = 'hmil'
