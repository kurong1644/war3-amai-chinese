function init_strategy_BarrackMix takes nothing returns nothing
    call AddHarass(2, 2, uRIFLEMAN)
    call AddHarass(2, 4, uFOOTMAN)
    set distraction_group = 2

























endfunction
function build_sequence_BarrackMix takes nothing returns nothing
if tier == 3 then

      call SetBuildReact(40, 2, uKNIGHT, 6, uRIFLEMAN, (enemy_unarmored + (enemy_air * 2) + enemy_magic - (enemy_normal * 2)), 4, 25, 80)
      call SetBuildReact(10, 0, uMORTAR, 0, uCOPTER, (enemy_unarmored + (enemy_air * 4) - (enemy_piercing * 4)), 4, 25, 65)
      if GetUpgradeLevel(uUPG_TANK) > 0 then
        call SetBuildReact(20, 1, uKNIGHT, 0, uROCKET_TANK, ((enemy_towers * 2) + enemy_air - (enemy_siege * 3) - enemy_normal), 4, 25, 70)
      else
        call SetBuildReact(20, 1, uKNIGHT, 0, TANK, ((enemy_towers * 2) + enemy_air - (enemy_siege * 3) - enemy_normal), 4, 25, 70)
      endif
      call BuildUnit(1, hero[1], 90)
      call BuildUnit(1, hero[2], 72)
      call BuildUpgr(Min((((TownCountDone(uFOOTMAN)) + TownCountDone(uKNIGHT))/4),3), uUPG_MELEE, 60)
      call BuildUpgr(Min((((TownCountDone(uRIFLEMAN)) + TownCountDone(uMORTAR) + TownCountDone(uCOPTER))/4),3), uUPG_RANGED, 60)
      call BuildUpgr(Min((((TownCountDone(uRIFLEMAN)) + TownCountDone(uMORTAR))/4),3), uUPG_LEATHER, 50)
      call BuildUpgr(Min((((TownCountDone(uFOOTMAN)) + TownCountDone(uKNIGHT) + TownCountDone(uCOPTER))/4),3), uUPG_ARMOR, 50)
      call BuildUpgr(Min((TownCountDone(uRIFLEMAN)/3),1), uUPG_GUN_RANGE, 70)
      call BuildUpgr(Min((TownCountDone(uMORTAR)/2),1), uUPG_FRAGS, 70)
      call BuildUpgr(Min((TownCountDone(uCOPTER)/2),1), uUPG_BOMBS, 70)
      call BuildUpgr(Min((TownCountDone(uFOOTMAN)/6),1), uUPG_DEFEND, 50)
      call BuildUpgr(Min((TownCountDone(uCOPTER)/3),1), uUPG_FLAK, 50)
      call BuildUpgr(Min((TownCountDone(TANK)/2),1), uUPG_TANK, 50)
      call BuildUpgr(Min((TownCountDone(uKNIGHT)/3),1), uUPG_BREEDING, 60)
      call BuildUnit(1, uARCANE_VAULT, 45)
























elseif tier == 2 then

      call SetBuildReact(20, 3, uFOOTMAN, 5, uRIFLEMAN, (enemy_unarmored + (enemy_air * 2) + enemy_magic - (enemy_normal * 2)), 4, 25, 70)
      call SetBuildReact(10, 0, uMORTAR, 0, uCOPTER, (enemy_air * 3 - (enemy_piercing * 3)), 4, 25, 50)
      call BuildUnit(1, uCASTLE, 62)
      call BuildUnit(1, hero[1], 80)
      call BuildUnit(1, hero[2], 72)
      call BuildUpgr(Min((TownCountDone(uRIFLEMAN)/3),1), uUPG_GUN_RANGE, 70)
      call BuildUpgr(Min((TownCountDone(uFOOTMAN)/5),1), uUPG_DEFEND, 70)
      call BuildUpgr(Min((((TownCountDone(uFOOTMAN)) + TownCountDone(uKNIGHT))/4),2), uUPG_MELEE, 60)
      call BuildUpgr(Min((((TownCountDone(uRIFLEMAN)) + TownCountDone(uMORTAR) + TownCountDone(uCOPTER))/4),2), uUPG_RANGED, 60)
      call BuildUpgr(Min((((TownCountDone(uRIFLEMAN)) + TownCountDone(uMORTAR))/4),2), uUPG_LEATHER, 50)
      call BuildUpgr(Min((((TownCountDone(uFOOTMAN)) + TownCountDone(uKNIGHT) + TownCountDone(uCOPTER))/4),2), uUPG_ARMOR, 50)
      call BuildUnit(1, uARCANE_VAULT, 55)
























else

      call SetBuildReact(18, 2, uFOOTMAN, 4, uRIFLEMAN, (enemy_unarmored + (enemy_air * 2) + enemy_magic - (enemy_normal * 2)), 4, 25, 70)
      call BuildUpgr(Min((TownCountDone(uFOOTMAN)/5),1), uUPG_DEFEND, 55)
      call BuildUnit(1, uKEEP, 75)
      call BuildUnit(1, hero[1], 120)
      call BuildUnit(1, uARCANE_VAULT, 55)
























endif
endfunction

function init_strategy_SanctumMix takes nothing returns nothing
    call AddHarass(2, 2, uRIFLEMAN)
    call AddHarass(2, 4, uFOOTMAN)
    set distraction_group = 2
































endfunction
function build_sequence_SanctumMix takes nothing returns nothing
if tier == 3 then

      call SetBuildReact(40, 3, uGRYPHON, 4, uHUMAN_DRAGON_HAWK, ((enemy_air * 2) - enemy_piercing), 4, 25, 85)
      call SetBuildReact(30, 3, uSPELL_BREAKER, 3, uSORCERESS, ((enemy_normal * 2) - enemy_magic - enemy_siege - enemy_piercing), 4, 25, 75)
      call BuildUnit(10, uPRIEST, 60)
      call BuildUnit(1, hero[1], 90)
      call BuildUnit(1, hero[2], 72)
      call BuildUpgr(Min(((TownCountDone(uSPELL_BREAKER) + TownCountDone(uHUMAN_DRAGON_HAWK) + TownCountDone(uGRYPHON))/4),3), uUPG_MELEE, 50)
      call BuildUpgr(Min(((TownCountDone(uGRYPHON) + TownCountDone(uHUMAN_DRAGON_HAWK))/3),3), uUPG_LEATHER, 50)
      call BuildUpgr(Min((TownCountDone(uSPELL_BREAKER)/2),3), uUPG_ARMOR, 50)
      call BuildUpgr(Min((TownCountDone(uSPELL_BREAKER)/3),1), uUPG_CONT_MAGIC, 50)
      call BuildUpgr(Min((TownCountDone(uHUMAN_DRAGON_HAWK)/2),1), uUPG_CLOUD, 70)
      call BuildUpgr(Min((TownCountDone(uPRIEST)/2),2), uUPG_PRAYING, 70)
      call BuildUpgr(Min((TownCountDone(uSORCERESS)/2),2), uUPG_SORCERY, 70)
      call BuildUpgr(Min((TownCountDone(uGRYPHON)/3),1), uUPG_HAMMERS, 60)
      call BuildUpgr(Min((TownCountDone(uGRYPHON)/4),1), uUPG_BREEDING, 60)
      call BuildUnit(1, uARCANE_VAULT, 45)































elseif tier == 2 then

      call SetBuildReact(20, 3, uSPELL_BREAKER, 0, uSORCERESS, ((enemy_normal * 2) - enemy_magic - enemy_siege - enemy_piercing), 4, 25, 65)
      call BuildUnit(7, uPRIEST, 55)
      call BuildUnit(4, uHUMAN_DRAGON_HAWK, 42)
      call BuildUnit(1, uCASTLE, 62)
      call BuildUnit(1, hero[1], 80)
      call BuildUnit(1, hero[2], 72)
      call BuildUpgr(Min(((TownCountDone(uSPELL_BREAKER) + TownCountDone(uHUMAN_DRAGON_HAWK) + TownCountDone(uGRYPHON))/4),2), uUPG_MELEE, 40)
      call BuildUpgr(Min(((TownCountDone(uGRYPHON) + TownCountDone(uHUMAN_DRAGON_HAWK))/2),2), uUPG_LEATHER, 50)
      call BuildUpgr(Min((TownCountDone(uSPELL_BREAKER)/2),2), uUPG_ARMOR, 30)
      call BuildUpgr(Min((TownCountDone(uPRIEST)/2),1), uUPG_PRAYING, 40)
      call BuildUpgr(Min((TownCountDone(uSORCERESS)/2),1), uUPG_SORCERY, 40)
      call BuildUnit(1, uARCANE_VAULT, 55)































else

      call BuildFront(1, uARCANE_TOWER, 75)
      call BuildUnit(1, hero[1], 80)
        call SetBuildReact(16, 4, uFOOTMAN, 0, uRIFLEMAN, (enemy_unarmored + (enemy_lightarmor * 2) + enemy_air + enemy_magic - (enemy_normal * 2)), 4, 25, 56) 
        call BuildUnit(1, uKEEP, 75)































endif
endfunction





