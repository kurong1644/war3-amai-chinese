function InitBuildings takes nothing returns nothing
  set building[0] = uAVIARY
  set building[1] = uBARRACKS
  set building[2] = uBLACKSMITH
  set building[3] = uCANNON_TOWER
  set building[4] = uCASTLE
  set building[5] = uGUARD_TOWER
  set building[6] = uHOUSE
  set building[7] = uHUMAN_ALTAR
  set building[8] = uKEEP
  set building[9] = uLUMBER_MILL
  set building[10] = uSANCTUM
  set building[11] = uARCANE_SANCTUM
  set building[12] = uTOWN_HALL
  set building[13] = uWATCH_TOWER
  set building[14] = uWORKSHOP
