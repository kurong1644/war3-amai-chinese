  set race_ancient_expansion_available = false
  set race_ancient_expansion_probability = 50
  set race_ancient_expansion_strength = 15
  set race_ancient_expansion_help_id = 0
  set race_item_expansion_available = false
  set race_item_expansion_probability = 35
  set race_item_sale_level = 0
  set race_item_expansion_item_id = 0
  set race_sell_ziggurats = false
  set race_ziggurat_keep_distance = 1500
  set race_build_farms_front = false
  set race_farms_front_limit = 4
  set race_farms_at_mine = 0
  set race_max_expa_mine_distance = 850
  set race_has_moonwells = false
  set race_towerrush_hero_rush_level = 1
  set race_ancient_expansion_hero_rush_level = 2
  set ghoul_prio = 250
  set race_min_ghouls = 2
  set race_max_ghouls = 5
  set groundid = 'ewsp'
  set race_ancient_barracks_rush_chance = 0
  set racial_burrow = 0
  set race_tower_upgrade2 = uARCANE_TOWER
  set race_tower_id_replace = 0
  set race_tower_move = false
  set race_tower_bypeon = false
  set race_tower_peon = 4
