  set building[7] = uCRYPT
  set building[8] = uSLAUGHTERHOUSE
  set building[9] = uDAMNED_TEMPLE
  set building[10] = uZIGGURAT_1
  set building[11] = uZIGGURAT_2
  set building[12] = uZIGGURAT_FROST
  set building[13] = uGRAVEYARD
