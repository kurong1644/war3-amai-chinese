function StrategyChanger takes nothing returns nothing
  local real array rp

  if not strat_change_allowed or strategy != chosen_strategy or debug_strategy > -1 or FoodUsed() >= 85 or GetMaximumEnemyStrength() < ver_strat_change_enemy_strength_min then
    return
  endif
  call chooseStrategyRP()
  call normalize_rp_strat()  // Makes priority much larger so the extra bonuses do not make as much of a difference


  set rp[STRAT_NormalUndead] = rp[STRAT_NormalUndead] + 0 * enemy_air
  set rp[STRAT_Wyrms] = rp[STRAT_Wyrms] + 5 * enemy_air
  set rp[STRAT_Banshee] = rp[STRAT_Banshee] + 0 * enemy_air
  set rp[STRAT_Necro] = rp[STRAT_Necro] + 0 * enemy_air
  set rp[STRAT_Ghouls] = rp[STRAT_Ghouls] + -5 * enemy_air
  set rp[STRAT_GargGhouls] = rp[STRAT_GargGhouls] + 6 * enemy_air
  set rp[STRAT_Fiends] = rp[STRAT_Fiends] + 6 * enemy_air
  set rp[STRAT_GargWyrm] = rp[STRAT_GargWyrm] + 10 * enemy_air
  set rp[STRAT_Aboms] = rp[STRAT_Aboms] + -5 * enemy_air
  set rp[STRAT_MeatFiends] = rp[STRAT_MeatFiends] + 5 * enemy_air
  set rp[STRAT_MassDestroyer] = rp[STRAT_MassDestroyer] + 0 * enemy_air
  set rp[STRAT_CryptMix] = rp[STRAT_CryptMix] + 0 * enemy_air
  set rp[STRAT_TempleMix] = rp[STRAT_TempleMix] + 0 * enemy_air
  set rp[STRAT_UAntiTower] = rp[STRAT_UAntiTower] + 0 * enemy_air
  set rp[STRAT_NormalUndead] = rp[STRAT_NormalUndead] + 0 * enemy_casters
  set rp[STRAT_Wyrms] = rp[STRAT_Wyrms] + 0 * enemy_casters
  set rp[STRAT_Banshee] = rp[STRAT_Banshee] + 1 * enemy_casters
  set rp[STRAT_Necro] = rp[STRAT_Necro] + 0 * enemy_casters
  set rp[STRAT_Ghouls] = rp[STRAT_Ghouls] + 0 * enemy_casters
  set rp[STRAT_GargGhouls] = rp[STRAT_GargGhouls] + 0 * enemy_casters
  set rp[STRAT_Fiends] = rp[STRAT_Fiends] + 0 * enemy_casters
  set rp[STRAT_GargWyrm] = rp[STRAT_GargWyrm] + 0 * enemy_casters
  set rp[STRAT_Aboms] = rp[STRAT_Aboms] + 0 * enemy_casters
  set rp[STRAT_MeatFiends] = rp[STRAT_MeatFiends] + 0 * enemy_casters
  set rp[STRAT_MassDestroyer] = rp[STRAT_MassDestroyer] + 10 * enemy_casters
  set rp[STRAT_CryptMix] = rp[STRAT_CryptMix] + 0 * enemy_casters
  set rp[STRAT_TempleMix] = rp[STRAT_TempleMix] + 0 * enemy_casters
  set rp[STRAT_UAntiTower] = rp[STRAT_UAntiTower] + 0 * enemy_casters
  set rp[STRAT_NormalUndead] = rp[STRAT_NormalUndead] + 0 * enemy_towers
  set rp[STRAT_Wyrms] = rp[STRAT_Wyrms] + 0 * enemy_towers
