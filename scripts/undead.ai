function guardBuild takes nothing returns nothing
  local integer cc_guard = 0

  set cc_guard = TownCount(uZIGGURAT_2)
  if cc_guard >= bn_guard then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_guard, uZIGGURAT_2, 90  )
  endif
endfunction

function cmdBuild takes nothing returns nothing
  if false then
  elseif strategy == 50 then
    call airairBuild()
  elseif strategy == 51 then
    call airgroundBuild()
  elseif strategy == 52 then
    call groundairBuild()
  elseif strategy == 53 then
    call groundgroundBuild()
  elseif strategy == 54 then
    call farmBuild()
  elseif strategy == 55 then
    call guardBuild()
  endif
endfunction

function set_skills takes nothing returns nothing
    if hero[1]== uNAGA_SORCERESS then
        call LoadSkills(1,1,1)
    elseif hero[2]== uNAGA_SORCERESS then
        call LoadSkills(2,1,2)
    elseif hero[3]== uNAGA_SORCERESS then
        call LoadSkills(3,1,3)
    endif
    if hero[1]== uBEAST_MASTER then
        call LoadSkills(1,2,1)
    elseif hero[2]== uBEAST_MASTER then
        call LoadSkills(2,2,2)
    elseif hero[3]== uBEAST_MASTER then
        call LoadSkills(3,2,3)
    endif
    if hero[1]== uDARK_RANGER then
        call LoadSkills(1,3,1)
    elseif hero[2]== uDARK_RANGER then
        call LoadSkills(2,3,2)
    elseif hero[3]== uDARK_RANGER then
        call LoadSkills(3,3,3)
    endif
    if hero[1]== uNEUTRAL_PIT_LORD then
        call LoadSkills(1,4,1)
    elseif hero[2]== uNEUTRAL_PIT_LORD then
        call LoadSkills(2,4,2)
    elseif hero[3]== uNEUTRAL_PIT_LORD then
        call LoadSkills(3,4,3)
    endif
    if hero[1]== uBREW_MASTER then
        call LoadSkills(1,5,1)
    elseif hero[2]== uBREW_MASTER then
        call LoadSkills(2,5,2)
    elseif hero[3]== uBREW_MASTER then
        call LoadSkills(3,5,3)
    endif
    if hero[1]== uGOBLIN_TINKER then
        call LoadSkills(1,6,1)
    elseif hero[2]== uGOBLIN_TINKER then
        call LoadSkills(2,6,2)
    elseif hero[3]== uGOBLIN_TINKER then
        call LoadSkills(3,6,3)
    endif
    if hero[1]== uFIRELORD then
        call LoadSkills(1,7,1)
    elseif hero[2]== uFIRELORD then
        call LoadSkills(2,7,2)
    elseif hero[3]== uFIRELORD then
        call LoadSkills(3,7,3)
    endif
    if hero[1]== uALCHEMIST then
        call LoadSkills(1,8,1)
    elseif hero[2]== uALCHEMIST then
        call LoadSkills(2,8,2)
    elseif hero[3]== uALCHEMIST then
        call LoadSkills(3,8,3)
    endif
    if hero[1]== uDEATH_KNIGHT then
        call LoadSkills(1,9,1)
    elseif hero[2]== uDEATH_KNIGHT then
        call LoadSkills(2,9,2)
    elseif hero[3]== uDEATH_KNIGHT then
        call LoadSkills(3,9,3)
    endif
    if hero[1]== uDREAD_LORD then
        call LoadSkills(1,10,1)
    elseif hero[2]== uDREAD_LORD then
        call LoadSkills(2,10,2)
    elseif hero[3]== uDREAD_LORD then
        call LoadSkills(3,10,3)
    endif
    if hero[1]== uLICH then
        call LoadSkills(1,11,1)
    elseif hero[2]== uLICH then
        call LoadSkills(2,11,2)
    elseif hero[3]== uLICH then
        call LoadSkills(3,11,3)
    endif
    if hero[1]== uCRYPT_LORD then
        call LoadSkills(1,12,1)
    elseif hero[2]== uCRYPT_LORD then
        call LoadSkills(2,12,2)
    elseif hero[3]== uCRYPT_LORD then
        call LoadSkills(3,12,3)
    endif
endfunction

function setup_force takes boolean inj returns nothing

    set wave = wave + 1

    call InitAssaultGroup()

    if inj then
      call RemoveInjuries()
    endif

    call SetMeleeGroupAM( hero[1] )
    call SetMeleeGroupAM( hero[2] )
    call SetMeleeGroupAM( hero[3] )
    call SetMeleeGroupAM( uABOMINATION )
    call SetMeleeGroupAM( uBANSHEE )
    call SetMeleeGroupAM( uCRYPT_FIEND )
    call SetMeleeGroupAM( uBURROWED_FIEND )
    call SetMeleeGroupAM( uFROST_WYRM )
    call SetMeleeGroupAM( uGARGOYLE )
    call SetMeleeGroupAM( uGHOUL )
    call SetMeleeGroupAM( uMEAT_WAGON )
    call SetMeleeGroupAM( uNECRO )
    call SetMeleeGroupAM( uOBSIDIAN_STATUE )
    call SetMeleeGroupAM( uBLK_SPHINX )
    call SetMeleeGroupAM( uCARRION_BEETLE )
    call SetMeleeGroupAM( uCARRION_BEETLE2 )
    call SetMeleeGroupAM( uCARRION_BEETLE3 )
    call SetMeleeGroupAM( uGOBLIN_TINKER_M )
    call SetMeleeGroupAM( uALCHEMIST_M1 )
    call SetMeleeGroupAM( uALCHEMIST_M2 )
    call SetMeleeGroupAM( uALCHEMIST_M3 )
    call AttackGroupAddNeutrals()
    call AttackGroupAddUnknown()

endfunction



function basic_melee takes integer food, integer prio returns nothing
    call FoodPoolAM(food, true, race_simple_melee, GetFoodUsed(old_id[race_simple_melee]), CanBuildUnit(race_advanced_melee), race_advanced_melee, GetFoodUsed(old_id[race_advanced_melee]), prio)
endfunction

function setup_ghouls takes nothing returns nothing
  local integer gn = TownCountDone(racial_ghoul)
  local integer wood = GetWood()

  if wave <= 2 then
    set harvesting_ghouls = 1
  //elseif wave==2 then
    //set attacking_ghouls = Max(6, gn - 2)
  //elseif wood < maximum_peon_wood then
    //set attacking_ghouls = gn - Max((gn - 4) - (4 * TownCountDone(neutral_shredder)), 0)
    //set harvesting_ghouls = Max(0,Min(10 - wood / minimum_peon_wood,c_ghoul_done))
    //set attacking_ghouls = gn - (havesting_ghouls - (4 * TownCountDone(neutral_shredder))
  //elseif wood > maximum_peon_wood and wood < minimum_peon_wood / 2 then
    //set attacking_ghouls = gn - Max(2 - (4 * TownCountDone(neutral_shredder)), 0)
  elseif wave <= 4 then
    set harvesting_ghouls = Max(1,Min(R2I(race_min_ghouls*LinearInterpolation(maximum_peon_wood, minimum_peon_wood, 1, 0, wood) + 0.5),gn) - (R2I(shredder_peon_count/2) * TownCountDone(neutral_shredder)))
  else
    set harvesting_ghouls = Max(1,Min(R2I(race_max_ghouls*LinearInterpolation(maximum_peon_wood, minimum_peon_wood, 1, 0, wood) + 0.5),gn) - (R2I(shredder_peon_count/2) * TownCountDone(neutral_shredder)))
  endif
  //set attacking_ghouls = gn - harvesting_ghouls
  //set attacking_ghouls = Min(Max(attacking_ghouls, 0), gn)
  //call Trace("Attacking Ghouls:" + Int2Str(gn - harvesting_ghouls))
  call Trace("Harvesting Ghouls:" + Int2Str(harvesting_ghouls))
endfunction

