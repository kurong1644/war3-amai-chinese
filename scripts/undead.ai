function initRacialUnits takes nothing returns nothing

    set racial_peon = uACOLYTE
    set racial_ghoul = uGHOUL
    set racial_expansion = uUNDEAD_MINE
    set racial_altar = uUNDEAD_ALTAR
    set uracial_altar = uUNDEAD_ALTAR
    set racial_lumber = uGRAVEYARD

    set racial_hall[1] = uNECROPOLIS_1
    set uracial_hall[1] = uNECROPOLIS_1
    set racial_hall[2] = uNECROPOLIS_2
    set uracial_hall[2] = uNECROPOLIS_2
    set racial_hall[3] = uNECROPOLIS_3
    set uracial_hall[3] = uNECROPOLIS_3
    // Basically if its not a undead type expansion method just make variable the first hall
    if racial_expansion == 0 then
      set racial_expansion = racial_hall[1]
    endif

    set racial_goldmine[minearray] = 'ugol'
    set minearray = minearray + 1
    set racial_goldmine[minearray] = 'ngol'
    set minearray = minearray + 1
    set gold_mines_ids[gold_mine_ids_size] = 'ugol'
    set gold_mine_ids_size = gold_mine_ids_size + 1
    set gold_mines_ids[gold_mine_ids_size] = 'egol'
    set gold_mine_ids_size = gold_mine_ids_size + 1
    set gold_mines_ids[gold_mine_ids_size] = 'ngol'
    set gold_mine_ids_size = gold_mine_ids_size + 1

    set racial_zigg[ziggarray] = 'uzg1'
    set ziggarray = ziggarray + 1
    set racial_zigg[ziggarray] = 'uzg2'
    set ziggarray = ziggarray + 1
    set racial_farm = uZIGGURAT_1
    if race_sell_ziggurats then
      set racial_zigg[ziggarray] = old_id[racial_farm]
      set ziggarray = ziggarray + 1
    endif

    set racial_shop = uTOMB_OF_RELICS
    set uracial_shop = uTOMB_OF_RELICS

endfunction

function initRacialTraits takes nothing returns nothing
  local integer i = 0

  set i = GetRandomInt(1, 100)
  set race_towerrush_available = (race_towerrush_available)
  if race_towerrush_available then
    call Trace("Towerrush variable is true")
  endif

endfunction

