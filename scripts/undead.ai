function SetRaceAggression takes nothing returns nothing
  set b_race_aggression[0] = 3
  set b_race_aggression[1] = 2
  set b_race_aggression[2] = 1
  set b_race_aggression[3] = 2
  set b_race_aggression[4] = 3
  set b_race_aggression[5] = 4
  set b_race_aggression[6] = -1
  set b_race_aggression[7] = 2
  set b_race_aggression[8] = 3
  set b_race_aggression[9] = 1
  set b_race_aggression[10] = 3
  set b_race_aggression[11] = 5
endfunction

