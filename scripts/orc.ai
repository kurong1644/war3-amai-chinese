function init_strategy_BladeGrunt takes nothing returns nothing
    call AddHarass(1, 2, uGRUNT)
    call AddHarass(2, 2, uRAIDER)
    set distraction_group = 2
    call AddHarass(3, 1, uBLADE_MASTER)
endfunction

function build_sequence_BladeGrunt takes nothing returns nothing
if tier == 3 then
      call BuildUnit(1, hero[3], 60)
      call BuildUnit(8, uGRUNT, 50)
      call BuildUnit(6, uRAIDER, 52)
      call BuildUnit(4, uTAUREN, 48)
      call BuildUnit(1, uCATAPULT, 45)
      call BuildUpgr(2, uUPG_ORC_MELEE, 44)
      call BuildUpgr(1, uUPG_ORC_BERSERK, 42)
elseif tier == 2 then
      call BuildUnit(1, hero[2], 72)
      call BuildUnit(6, uGRUNT, 62)
      call BuildUnit(4, uRAIDER, 60)
      call BuildUnit(1, uFORTRESS, 62)
      call BuildUnit(2, uBURROW, 50)
      call BuildUpgr(1, uUPG_ORC_ENSNARE, 50)
      call BuildUpgr(1, uUPG_ORC_MELEE, 46)
else
      call BuildUnit(1, uSTRONGHOLD, 75)
      call BuildUnit(1, hero[1], 95)
      call BuildUnit(8, uGRUNT, 76)
      call BuildUnit(1, uBURROW, 60)
      call BuildUnit(1, uORC_BARRACKS, 55)
endif
endfunction

function init_strategy takes nothing returns nothing
  call InitBlockList()
  call InitRBlockList()
  call InitHarass()
  call global_init_strategy()
  set exp_first_time = p_exp_first_time[profile] + strategy_first_exp_time[strategy]
  set exp_second_time = p_exp_second_time[profile] + strategy_second_exp_time[strategy]
  call ApplyStrategyRaceAggression()

if strategy < 8 then
if strategy < 3 then
if strategy < 1 then
call init_strategy_BarrackMix()
 else
if strategy < 2 then
call init_strategy_FastSh()
 else
call init_strategy_Wyvern()
 endif
 endif
 else
if strategy < 6 then
if strategy < 5 then
if strategy < 4 then
call init_strategy_AntiPierce()
 else
call init_strategy_OAntiTower()
 endif
 else
call init_strategy_HeadCatapults()
 endif
 else
if strategy < 7 then
call init_strategy_NormalOrc()
 else
call init_strategy_HHunters()
 endif
 endif
 endif
 else
if strategy < 12 then
if strategy < 10 then
if strategy < 9 then
call init_strategy_VersusHuman()
 else
call init_strategy_VersusUndead()
 endif
 else
if strategy < 11 then
call init_strategy_VersusElf()
 else
call init_strategy_WyvSh()
 endif
 endif
 else
if strategy < 15 then
if strategy < 13 then
call init_strategy_GruntCatapults()
 else
if strategy < 14 then
call init_strategy_AntiAir()
 else
call init_strategy_Raiders()
 endif
 endif
 else
if strategy < 16 then
call init_strategy_BestiaryMix()
 else
call init_strategy_BladeGrunt()
 endif
 endif
 endif
 endif

endfunction

function build_sequence takes nothing returns nothing
  call global_build_sequence()
  if towerrush then
    //call AddBlock(2, GRUNT, true, 0, STRONGHOLD, 1000)
    call BuildUnit(1, hero[1], 140)
    if needed1[race_tower_id] != 0 then
      call BuildUnit(1, needed1[race_tower_id], 130)
    endif
    if needed2[race_tower_id] != 0 then
      call BuildUnit(1, needed2[race_tower_id], 130)
    endif
    if needed3[race_tower_id] != 0 and needed3[race_tower_id] != UPGRADED then
      call BuildUnit(1, needed3[race_tower_id], 130)
    endif
    if race_tower_upgrade != 0 then
      if needed1[race_tower_upgrade] != 0 then
        call BuildUnit(1, needed1[race_tower_upgrade], 120)
      endif
      if needed2[race_tower_upgrade] != 0 then
        call BuildUnit(1, needed2[race_tower_upgrade], 120)
      endif
      if needed3[race_tower_upgrade] != 0 and needed3[race_tower_upgrade] != UPGRADED then
        call BuildUnit(1, needed3[race_tower_upgrade], 120)
      endif
    endif
    if race_tower_upgrade2 != 0 then
      if needed1[race_tower_upgrade2] != 0 then
        call BuildUnit(1, needed1[race_tower_upgrade2], 110)
      endif
      if needed2[race_tower_upgrade2] != 0 then
        call BuildUnit(1, needed2[race_tower_upgrade2], 110)
      endif
      if needed3[race_tower_upgrade2] != 0 and needed3[race_tower_upgrade2] != UPGRADED then
        call BuildUnit(1, needed3[race_tower_upgrade2], 110)
      endif
    endif
    if race_tower_item_must and race_tower_item != 0 then
      call BuildItem(race_tower_item_quantity, race_tower_item, 130)
    endif  

  endif
  if build_emergency_healing_item != 0 then
    // This occurs when tried to buy an emergency healing item but was unable to, so instead add to the build queue so all requirements can be built.
    call BuildItem(1, build_emergency_healing_item, 150)
  endif  
  if strategy >= rp_strat_length then
    call cmdBuild()
  else
if strategy < 8 then
if strategy < 3 then
if strategy < 1 then
call build_sequence_BarrackMix()
 else
if strategy < 2 then
call build_sequence_FastSh()
 else
call build_sequence_Wyvern()
 endif
 endif
 else
if strategy < 6 then
if strategy < 5 then
if strategy < 4 then
call build_sequence_AntiPierce()
 else
call build_sequence_OAntiTower()
 endif
 else
call build_sequence_HeadCatapults()
 endif
 else
if strategy < 7 then
call build_sequence_NormalOrc()
 else
call build_sequence_HHunters()
 endif
 endif
 endif
 else
if strategy < 12 then
if strategy < 10 then
if strategy < 9 then
call build_sequence_VersusHuman()
 else
call build_sequence_VersusUndead()
 endif
 else
if strategy < 11 then
call build_sequence_VersusElf()
 else
call build_sequence_WyvSh()
 endif
 endif
 else
if strategy < 15 then
if strategy < 13 then
call build_sequence_GruntCatapults()
 else
if strategy < 14 then
call build_sequence_AntiAir()
 else
call build_sequence_Raiders()
 endif
 endif
 else
if strategy < 16 then
call build_sequence_BestiaryMix()
 else
call build_sequence_BladeGrunt()
 endif
 endif
 endif
 endif
  endif
endfunction

function attack_sequence_all takes nothing returns nothing

  call Trace("Starting Attack Thread Loop") 

  if ver_heroes then
  loop
      exitwhen TownCountDone(hero[1]) > 0 or desperation_assault
      call StaggerSleep(2 * sleep_multiplier, 2 * sleep_multiplier + 2)
  //    call Trace("Attack Loop1")
  endloop
  endif

  call StaggerSleep(0,2)
  loop

    call HealArmy()
    //call Trace("RACIAL ATTACK: Army Healed") 

    //call HeroHealingBugFix()     // To hopefully fix bugs with attack system as will keep them running

    if ver_heroes then
      set creeping_only = AwaitMeleeHeroesAM()
    endif

    exitwhen player_defeated

    if no_attack_allowed then
      call Trace("RACIAL ATTACK: NO ATTACK SETTING IS ON")
    else

      if race_has_ghouls and race_ghouls_attack then
        call setup_ghouls()

        set peons_assigned = false
        set ghouls_in_attack = true
        call Trace("RACIAL ATTACK: Assigning Peons")
        loop
          exitwhen peons_assigned or desperation_assault
          call StaggerSleep(2, 3)
        endloop
        call Trace("RACIAL ATTACK: exit Assigning Peons")
      endif

      call Trace("RACIAL ATTACK: waiting for troops")
      loop
        exitwhen GetOwnStrength() >= minimum_attack_strength or desperation_assault
        call StaggerSleep(5 * sleep_multiplier, 5 * sleep_multiplier + 2)
      endloop
      call Trace("RACIAL ATTACK: exit waiting troops")

      call setup_force(false)
      call universal_attack_sequence()
      set ghouls_in_attack = false
    endif

    call StaggerSleep(sleep_multiplier,sleep_multiplier + 2)
  endloop
endfunction

function harvest_gold takes integer townid returns nothing
  local integer town_idx = 0
  if townid < own_town_num then
    set town_idx = own_town[townid]
    if TownHasMine(townid) or GetResourceAmount(town_mine[town_idx]) > 0 then
      call HarvestGold(townid,ver_optimal_gold)
    endif
  endif
endfunction

function peon_assignment takes nothing returns nothing
  call ClearHarvestAI()

  if desperation_assault then
    return
  endif

  if race_manual_loading then
     if FoodSpace() <= 0 and TownCount(racial_peon) == TownCountDone(racial_peon) and TownCount(racial_peon) <= 4 then  // Scenario A
        //call HarvestGold(0, 2)  // no foodspace , no peon , need one harvest mine peon build Farms
        call HarvestWood(0, Max(1,TownCountDone(racial_peon) - 2))  //seize a seat
        //call HarvestGold(0, ver_optimal_gold - 2)                   //seize a seat
     elseif not hero_built[1] and TownCount(racial_peon) < 8 then  // Scenario B , game just started
        //call HarvestGold(0, 3)  // need more wisp HarvestWood , avoidance no wood cannot build and AI stop construction
        call HarvestWood(0, Max(1,TownCountDone(racial_peon) - 3))  //seize a seat
        //call HarvestGold(0, ver_optimal_gold - 3)                   //seize a seat
     else  //Scenario C
        //call HarvestGold(0, ver_optimal_gold)
     endif
      // seize a seat is must be retained , use tell AI have ver_optimal_gold peon harvest gold
      // if delete seize a seat , when AI From A or B to Scenario C ï¼will have one or two peon cannot harvest , because no vacancy in the mine , but the peon order is harvest gold , the peon not controlled by HarvestWood
  else
    call harvest_gold(0)
    call harvest_gold(1)
    call harvest_gold(2)
    call harvest_gold(3)
  endif
  if race_has_ghouls then
    call HarvestWood(0, Max(harvesting_ghouls,0))
    if peons_assigned and ghouls_in_attack then
      call HarvestWood(0, Max(TownCountDone(racial_ghoul) - attacking_ghouls - harvesting_ghouls,0)) // spare ghouls not doing anything and not assigned to attack yet
      if attacking_ghouls > 0 then
         call FormGroupAM(0) // This will unforunately slow attack movement when reinforcing, but nothing we can do right now, only way to get attacking ghouls to stay off the lumber at present
      endif
    else
      call HarvestWood(0, Max(TownCountDone(racial_ghoul) - harvesting_ghouls,0)) // spare ghouls not doing anything
    endif  
    set peons_assigned = true  
  elseif race_manual_loading then
    call HarvestWood(0, 20)
  endif
  
  call ForcedHarvest()
  
endfunction

function KeepHarvestLocal takes nothing returns nothing
  local group g = null
  local unit u = null
  local unit buildu = null
  local real buildx = 0
  local real buildy = 0
  if fixharvest < 60 then
    set g = CreateGroup()
    set fixharvest = fixharvest + 1
    call GroupEnumUnitsOfPlayer(g, ai_player, null)
    loop 
      set u = FirstOfGroup(g)
      exitwhen u == null
      if GetUnitTypeId(u) == old_id[racial_peon] and UnitAlive(u) then
        call CreateDebugTagLoc("O:" + Int2Str(GetUnitCurrentOrder(u)), 10, GetUnitX(u), GetUnitY(u), 1.00, 0.80)
        if not IsUnitInGroup(u, harvestgrp) and DistanceBetweenPoints_dk(GetUnitLoc(u), home_location) > front_base_distance * 1.25 and IsConstructionOrder(GetUnitCurrentOrder(u)) and (racial_rushcreep == 0 or (TownCount(racial_rushcreep) <= 0 and GetUnitCurrentOrder(u) != old_id[racial_rushcreep])) and GetUnitCurrentOrder(u) != old_id[racial_expansion] then // going on adventure building far away too early so force them back
          set buildu = CreatePathingUnitFull(buildu, Player(PLAYER_NEUTRAL_PASSIVE), GetUnitCurrentOrder(u), GetLocationX(home_location) + ISign() * GetRandomReal(500, 1000), GetLocationY(home_location) + ISign() * GetRandomReal(-1000, -500))
          set buildx = GetUnitX(buildu)
          set buildy = GetUnitY(buildu)
          call RemoveUnit(buildu)
          set buildu = null
          call IssuePointOrderById(u, GetUnitCurrentOrder(u), buildx, buildy)
        endif
      endif
      call GroupRemoveUnit(g, u)
    endloop
    call DestroyGroup(g)
    set g = null
  endif
endfunction

function peon_assignment_all takes nothing returns nothing

  //if race_has_power_build then
    //call TownHallCheck()
  //endif

  call CreateDebugTagLoc("MINES:" + Int2Str(GetMinesOwned()) + " Harvested:" + Int2Str(GetMinesHarvested()), 10, GetLocationX(home_location), GetLocationY(home_location), 1.00, 0.80)
  if (race_has_ghouls and race_ghouls_attack) or race_no_wood_harvest or race_manual_loading then
    call peon_assignment()
  else
    call universal_peon_assignment()
  endif
  call KeepHarvestLocal()
endfunction

function calculate_strat_timer_seconds takes integer seconds returns integer
  local integer x = GetRandomInt(-30, 30) - seconds
  set x = x*R2I(1 + 0.25*I2R(Max((3 - tier), 0))) // tier modifier, earlier tiers keep strategy for longer
  set x = x/R2I(1 + 0.5*I2R(Max(difficulty - 2, 0))) // difficulty modifier, faster change time on insane
  return x
endfunction

function calculate_strat_timer takes nothing returns integer
  return calculate_strat_timer_seconds(strat_minimum_time[strategy]*6)
endfunction

function build_sequence_all takes nothing returns nothing
  local integer x = calculate_strat_timer()
  local integer counter_timer = R2I(RMin(I2R(calculate_strat_timer())/2,-60))
  local integer new_tier = 0
  local integer last_counter = -1
  local boolean set_counter = true
  local boolean reportStrategy = false
  local boolean reset_counter = false

  call Trace("Starting Build Sequence Loop")
  loop
    exitwhen new_tier >= tiernum
    set bl_tier_lockactive[new_tier] = true
    set new_tier = new_tier + 1
  endloop
  set new_tier = 0
    loop
      exitwhen player_defeated

    if recalculate_heros then
        call AMAI_PickMeleeHero()
      call set_skills()
      set recalculate_heros = false
    endif

    //call Trace("BUILD SEQUENCE: Running Loop")
    call peon_assignment_all()
    //call Trace("BUILD SEQUENCE: peon_assignment")
    if x > 12 then
      set x = 0
      //call Trace("BUILD SEQUENCE: StrategyChanger")
      call StrategyChanger()
      if strategy <= 49 then
          set x = Min(Max(calculate_strat_timer() / 2, -120), -60) // If same strategy persists give more time
          set counter_timer = 2
          set reset_counter = true
    endif
    endif

    if last_strategy != strategy then
      set last_strategy = strategy
      set reportStrategy = true
      call SetRaceAggression()
      if strategy <= 49 then
        set x = calculate_strat_timer()
        set counter_timer = R2I(RMin(x/2,-80)) // Don't allow counter to change so soon
        set reset_counter = true
      endif
      //call Trace("BUILD SEQUENCE: InitBuildarray")
      call InitBuildArrayAM()
      //call Trace("BUILD SEQUENCE: init_strategy")
      call init_strategy()
    endif
    if debugging > 0 then
      call UpdateDebugTextTag(debugstrattag, "Strat:" + GetCurrentStrategyName(), 18, GetLocationX(home_location) - 300, GetLocationY(home_location) - 300)
      call SetTextTagPermanent(debugstrattag, true)
    endif

    if (x > counter_timer and counter_timer < 0) or reset_counter then
      set chosen_counter = DetermineCounterForce()
      call InitBuildArrayAM()
      if last_counter != chosen_counter and (debugging > 0 or GetRandomInt(1,5) == 1) then // Only randomly report counter changes to allies not every single time unless debug mode is on
        set reportStrategy = true
      endif
      set set_counter = true
      if reset_counter then
        set reset_counter = false
      else
        set counter_timer = 2 // Once fired don't change again until strategy changes
      endif
    endif
   if debugging > 0 then
      call UpdateDebugTextTag(debugcountertag, "Counter:" + strengthtext[chosen_counter], 18, GetLocationX(home_location) - 600, GetLocationY(home_location) - 600)
      call SetTextTagPermanent(debugcountertag, true)
   endif

    if reportStrategy then
      set reportStrategy = false
      if chatting then
        call QueueStrategy(GetCurrentStrategyReport() + GetCurrentDynamicReport())
      endif
      //call DisplayToAlliesImportant( GetCurrentStrategyReport() + GetCurrentDynamicReport())
      //call DisplayToObserversImportant( GetCurrentStrategyReport() + GetCurrentDynamicReport())
    endif

    set new_tier = GetTier()
    if tier != new_tier then
      set tier = new_tier
      //call Trace("BUILD SEQUENCE: initbuildarray2")
      call InitBuildArrayAM()
    endif

    //call Trace("BUILD SEQUENCE: build_sequence")
    call Sleep(0.05)
    call build_sequence()
    if set_counter == true then 
      call DynamicStrategySelector()
      set set_counter = false
    endif
    call Sleep(3 * sleep_multiplier)
    //call Trace("BUILD SEQUENCE: peon_assignment 2")	  
    //call peon_assignment_all()
    //call Sleep(3 * sleep_multiplier)
    set x = x + Max(R2I(3*sleep_multiplier), 1)
  endloop
endfunction



