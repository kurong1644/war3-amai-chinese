function InitBuildings takes nothing returns nothing
  set building[0] = uORC_ALTAR
  set building[1] = uORC_BARRACKS
  set building[2] = uBESTIARY
  set building[3] = uFORGE
  set building[4] = uFORTRESS
  set building[5] = uGREAT_HALL
  set building[6] = uLODGE
  set building[7] = uSTRONGHOLD
  set building[8] = uBURROW
  set building[9] = uTOTEM
  set building[10] = uORC_WATCH_TOWER
  set building[11] = uVOODOO_LOUNGE
  set building_length = 12
endfunction

function initRacialUnits takes nothing returns nothing

    set racial_peon = uPEON
    set racial_altar = uORC_ALTAR
    set uracial_altar = uORC_ALTAR
    set racial_lumber = uFORGE

    set racial_hall[1] = uGREAT_HALL
    set uracial_hall[1] = uGREAT_HALL
    set racial_hall[2] = uSTRONGHOLD
    set uracial_hall[2] = uSTRONGHOLD
    set racial_hall[3] = uFORTRESS
    set uracial_hall[3] = uFORTRESS
    // Basically if its not a undead type expansion method just make variable the first hall
    if racial_expansion == 0 then
      set racial_expansion = racial_hall[1]
    endif

    set racial_goldmine[minearray] = 'ngol'
    set minearray = minearray + 1
    set gold_mines_ids[gold_mine_ids_size] = 'ugol'
    set gold_mine_ids_size = gold_mine_ids_size + 1
    set gold_mines_ids[gold_mine_ids_size] = 'egol'
    set gold_mine_ids_size = gold_mine_ids_size + 1
    set gold_mines_ids[gold_mine_ids_size] = 'ngol'
    set gold_mine_ids_size = gold_mine_ids_size + 1

    set racial_farm = uBURROW
    if race_sell_ziggurats then
      set racial_zigg[ziggarray] = old_id[racial_farm]
      set ziggarray = ziggarray + 1
    endif

    set racial_shop = uVOODOO_LOUNGE
    set uracial_shop = uVOODOO_LOUNGE

endfunction

function initRacialTraits takes nothing returns nothing
  local integer i = 0

  set i = GetRandomInt(1, 100)
  set race_towerrush_available = (race_towerrush_available)
  if race_towerrush_available then
    call Trace("Towerrush variable is true")
  endif

endfunction

