function airairBuild takes nothing returns nothing
  local integer cc_airair = 0

  set cc_airair = TownCount(uWYVERN)
  if cc_airair >= bn_airair then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_airair, uWYVERN, 90  )
  endif
endfunction
function airgroundBuild takes nothing returns nothing
  local integer cc_airground = 0

  set cc_airground = TownCount(uWYVERN)
  if cc_airground >= bn_airground then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_airground, uWYVERN, 90  )
  endif
endfunction
function groundairBuild takes nothing returns nothing
  local integer cc_groundair = 0

  set cc_groundair = TownCount(uHEAD_HUNTER)
  if cc_groundair >= bn_groundair then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_groundair, uHEAD_HUNTER, 90  )
  endif
endfunction
function groundgroundBuild takes nothing returns nothing
  local integer cc_groundground = 0

  set cc_groundground = TownCount(uGRUNT)
  if cc_groundground >= bn_groundground then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_groundground, uGRUNT, 90  )
  endif
endfunction
function farmBuild takes nothing returns nothing
  local integer cc_farm = 0

  set cc_farm = TownCount(uBURROW)
  if cc_farm >= bn_farm then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_farm, uBURROW, 90  )
  endif
endfunction
function guardBuild takes nothing returns nothing
  local integer cc_guard = 0

  set cc_guard = TownCount(uORC_WATCH_TOWER)
  if cc_guard >= bn_guard then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_guard, uORC_WATCH_TOWER, 90  )
  endif
endfunction

function cmdBuild takes nothing returns nothing
  if false then
  elseif strategy == 50 then
    call airairBuild()
  elseif strategy == 51 then
    call airgroundBuild()
  elseif strategy == 52 then
    call groundairBuild()
  elseif strategy == 53 then
    call groundgroundBuild()
  elseif strategy == 54 then
    call farmBuild()
  elseif strategy == 55 then
    call guardBuild()
  endif
endfunction

function set_skills takes nothing returns nothing
    if hero[1]== uNAGA_SORCERESS then
        call LoadSkills(1,1,1)
    elseif hero[2]== uNAGA_SORCERESS then
        call LoadSkills(2,1,2)
    elseif hero[3]== uNAGA_SORCERESS then
        call LoadSkills(3,1,3)
    endif
    if hero[1]== uBEAST_MASTER then
        call LoadSkills(1,2,1)
    elseif hero[2]== uBEAST_MASTER then
        call LoadSkills(2,2,2)
    elseif hero[3]== uBEAST_MASTER then
        call LoadSkills(3,2,3)
    endif
    if hero[1]== uDARK_RANGER  then
        call LoadSkills(1,3,1)
    elseif hero[2]== uDARK_RANGER  then
        call LoadSkills(2,3,2)
    elseif hero[3]== uDARK_RANGER  then
        call LoadSkills(3,3,3)
    endif
    if hero[1]== uNEUTRAL_PIT_LORD  then
        call LoadSkills(1,4,1)
    elseif hero[2]== uNEUTRAL_PIT_LORD  then
        call LoadSkills(2,4,2)
    elseif hero[3]== uNEUTRAL_PIT_LORD  then
        call LoadSkills(3,4,3)
    endif
    if hero[1]== uBREW_MASTER  then
        call LoadSkills(1,5,1)
    elseif hero[2]== uBREW_MASTER  then
        call LoadSkills(2,5,2)
    elseif hero[3]== uBREW_MASTER  then
        call LoadSkills(3,5,3)
    endif
    if hero[1]== uGOBLIN_TINKER then
        call LoadSkills(1,6,1)
    elseif hero[2]== uGOBLIN_TINKER then
        call LoadSkills(2,6,2)
    elseif hero[3]== uGOBLIN_TINKER then
        call LoadSkills(3,6,3)
    endif
    if hero[1]== uFIRELORD then
        call LoadSkills(1,7,1)
    elseif hero[2]== uFIRELORD then
        call LoadSkills(2,7,2)
    elseif hero[3]== uFIRELORD then
        call LoadSkills(3,7,3)
    endif
    if hero[1]== uALCHEMIST then
        call LoadSkills(1,8,1)
    elseif hero[2]== uALCHEMIST then
        call LoadSkills(2,8,2)
    elseif hero[3]== uALCHEMIST then
        call LoadSkills(3,8,3)
    endif
    if hero[1]== uBLADE_MASTER then
        call LoadSkills(1,9,1)
    elseif hero[2]== uBLADE_MASTER then
        call LoadSkills(2,9,2)
    elseif hero[3]== uBLADE_MASTER then
        call LoadSkills(3,9,3)
    endif
    if hero[1]== uFAR_SEER then
        call LoadSkills(1,10,1)
    elseif hero[2]== uFAR_SEER then
        call LoadSkills(2,10,2)
    elseif hero[3]== uFAR_SEER then
        call LoadSkills(3,10,3)
    endif
    if hero[1]== uTAUREN_CHIEF then
        call LoadSkills(1,11,1)
    elseif hero[2]== uTAUREN_CHIEF then
        call LoadSkills(2,11,2)
    elseif hero[3]== uTAUREN_CHIEF then
        call LoadSkills(3,11,3)
    endif
    if hero[1]== uSHADOW_HUNTER then
        call LoadSkills(1,12,1)
    elseif hero[2]== uSHADOW_HUNTER then
        call LoadSkills(2,12,2)
    elseif hero[3]== uSHADOW_HUNTER then
        call LoadSkills(3,12,3)
    endif
endfunction

function setup_force takes boolean inj returns nothing

    set wave = wave + 1

    call InitAssaultGroup()

    if inj then
      call RemoveInjuries()
    endif

    call SetMeleeGroupAM( hero[1] )
    call SetMeleeGroupAM( hero[2] )
    call SetMeleeGroupAM( hero[3] )
    call SetMeleeGroupAM( uCATAPULT )
    call SetMeleeGroupAM( uWITCH_DOCTOR )
    call SetMeleeGroupAM( uGRUNT )
    call SetMeleeGroupAM( uHEAD_HUNTER )
    call SetMeleeGroupAM( uBERSERKER )
    call SetMeleeGroupAM( uKODO_BEAST )
    call SetMeleeGroupAM( uRAIDER )
    call SetMeleeGroupAM( uSHAMAN )
    call SetMeleeGroupAM( uTAUREN )
    call SetMeleeGroupAM( uWYVERN )
    call SetMeleeGroupAM( uBATRIDER )
    call SetMeleeGroupAM( uSPIRIT_WALKER )
    call SetMeleeGroupAM( uSPIRIT_WALKER_M )
    call SetMeleeGroupAM( uGOBLIN_TINKER_M )
    call SetMeleeGroupAM( uALCHEMIST_M1 )
    call SetMeleeGroupAM( uALCHEMIST_M2 )
    call SetMeleeGroupAM( uALCHEMIST_M3 )
    call AttackGroupAddNeutrals()
    call AttackGroupAddUnknown()

endfunction



function basic_melee takes integer food, integer prio returns nothing
    call FoodPoolAM(food, true, race_simple_melee, GetFoodUsed(old_id[race_simple_melee]), CanBuildUnit(race_advanced_melee), race_advanced_melee, GetFoodUsed(old_id[race_advanced_melee]), prio)
endfunction

function setup_ghouls takes nothing returns nothing
  local integer gn = TownCountDone(racial_ghoul)
  local integer wood = GetWood()

  if wave <= 2 then
    set harvesting_ghouls = 1
  //elseif wave==2 then
    //set attacking_ghouls = Max(6, gn - 2)
  //elseif wood < maximum_peon_wood then
    //set attacking_ghouls = gn - Max((gn - 4) - (4 * TownCountDone(neutral_shredder)), 0)
    //set harvesting_ghouls = Max(0,Min(10 - wood / minimum_peon_wood,c_ghoul_done))
    //set attacking_ghouls = gn - (havesting_ghouls - (4 * TownCountDone(neutral_shredder))
  //elseif wood > maximum_peon_wood and wood < minimum_peon_wood / 2 then
    //set attacking_ghouls = gn - Max(2 - (4 * TownCountDone(neutral_shredder)), 0)
  elseif wave <= 4 then
    set harvesting_ghouls = Max(1,Min(R2I(race_min_ghouls*LinearInterpolation(maximum_peon_wood, minimum_peon_wood, 1, 0, wood) + 0.5),gn) - (R2I(shredder_peon_count/2) * TownCountDone(neutral_shredder)))
  else
    set harvesting_ghouls = Max(1,Min(R2I(race_max_ghouls*LinearInterpolation(maximum_peon_wood, minimum_peon_wood, 1, 0, wood) + 0.5),gn) - (R2I(shredder_peon_count/2) * TownCountDone(neutral_shredder)))
  endif
  //set attacking_ghouls = gn - harvesting_ghouls
  //set attacking_ghouls = Min(Max(attacking_ghouls, 0), gn)
  //call Trace("Attacking Ghouls:" + Int2Str(gn - harvesting_ghouls))
  call Trace("Harvesting Ghouls:" + Int2Str(harvesting_ghouls))
endfunction

//============================================================================
//  global builds
//============================================================================
function global_init_strategy takes nothing returns nothing
    call SetTierBlock(1, 0.5, 30, false)
    call SetTierBlock(2, 0.5, 45, false)
    if not IsMapFlagSet(MAP_RANDOM_HERO) then
      call AddBlock(1, uORC_ALTAR, false, 0, uBURROW, 16)
      call AddBlock(1, uORC_ALTAR, false, 0, uORC_BARRACKS, 16)
      call AddBlock(1, uORC_ALTAR, true, 0, uVOODOO_LOUNGE, 36)
    endif
    call AddBlock(1, uORC_BARRACKS, true, 0, uVOODOO_LOUNGE, 36)
    call AddBlock(1, uBURROW, true, 0, uVOODOO_LOUNGE, 36)
    call AddBlock(1, uORC_BARRACKS, false, 0, uFORGE, 20)
    call AddBlock(1, uORC_BARRACKS, true, 0, uORC_WATCH_TOWER, 36)
    call AddHarass(1, 1, uGRUNT)
    call AddHarass(3, 2, uWYVERN)
    call AddHarass(4, 1, uBLADE_MASTER)
























































endfunction
function global_build_sequence takes nothing returns nothing
    // Anti rush
    if GetRushFactor() < 5000 then
      call BuildAtMine(1, uORC_WATCH_TOWER, 42)
      call BuildFront(1, uORC_WATCH_TOWER, 45)
    endif
    if GetGold() > 500 then
      call BuildFront(2, uORC_WATCH_TOWER, 40)
    endif
    if HasExpanded() then
      call DefendTownsDone(1, uBURROW, 70)
      call DefendTownsFrontDone(2, uORC_WATCH_TOWER, 70)
      if GetGold() > 2000 then
            call DefendTownsFrontDone(4, uORC_WATCH_TOWER, 45)
            if tier >= 2 and TownCount(uORC_WATCH_TOWER) >= 4 and TownCount(uVOODOO_LOUNGE) < 2 then
                  call DefendTownsDone(1, uVOODOO_LOUNGE, 40)
            endif
      endif
    endif

      if urgent_healing_count > 3 then
            call BuildItem(1, uHEALING_SALVE, 120)
      else
            call BuildItem(1, uHEALING_SALVE, 90)
      endif
      call BuildItem(2, uHEALING_SALVE, 50)
      call BuildItem(1, uM_SCROLL_OF_HEALING, 55)
      
      call BuildItem(1, uSCROLL_OF_SPEED, 70)
      call BuildItem(1, uSCROLL_OF_PROTECTION, 40)
      call BuildItem(1, uPOTION_OF_LESSER_INVULNERBILITY, 50)
      call BuildItem(1, uBOOTS_OF_SPEED, 50)
      if hero[1] == uBLADE_MASTER then
            call BuildItem(1, uLESSER_CLARITY_POTION, 70)
      endif
      if tier == 1 then
	      call BuildItem(1, uM_TOWN_PORTAL, 100)
      endif
      if tier > 1 then
            call BuildItem(1, uHEALING_POTION, 70)
            call BuildItem(1, uTOWN_PORTAL, 150)
      endif

    // DYNAMIC
    call ResetDynamicSystem()
    if tier == 1 then
      call AddUnitToAntiair(uHEAD_HUNTER,29)
      call AddUnitToAnticasters(uHEAD_HUNTER,29)
      call AddUnitToAntitowers(uCATAPULT,29)
      call AddUnitToAntipiercing(uGRUNT, 29)
      call AddUnitToAntinormal(uGRUNT, 30)
      call AddUnitToAntisiege(uGRUNT,29)
      call AddUnitToAntimagic(uHEAD_HUNTER,29)
      call AddUnitToAntiunarmored(uHEAD_HUNTER,30)
      call AddUnitToAntiunarmored(uCATAPULT,7)
      call AddUnitToAntilightarmor(uHEAD_HUNTER,1)
      call AddUnitToAntimediumarmor(uGRUNT,30)
      call AddUnitToAntiheavyarmor(uGRUNT,29)
      call DynamicBuildUnit(40, 40)
      call BuildUnit(1, merc_healer, 65)
      call BuildUnit(1, merc_stopper, 65)
    elseif tier == 2 then
      call AddUnitToAntiair(uHEAD_HUNTER,1)
      call AddUnitToAntiair(uBATRIDER,1)
      call AddUnitToAntiair(uRAIDER,GetUpgradeLevel(old_id[uUPG_ORC_ENSNARE]))
      call AddUnitToAnticasters(uSPIRIT_WALKER,15*GetUpgradeLevel(old_id[uUPG_ORC_SWALKER]))
      call AddUnitToAnticasters(uSHAMAN,5)
      call AddUnitToAntitowers(uCATAPULT,8+GetUpgradeLevel(old_id[uUPG_ORC_NAPTHA]))
      call AddUnitToAntitowers(uBATRIDER,1+GetUpgradeLevel(old_id[uUPG_ORC_FIRE]))
      call AddUnitToAntitowers(uRAIDER,1)
      call AddUnitToAntipiercing(uRAIDER, 1)
      call AddUnitToAntipiercing(uHEAD_HUNTER, 1)
      call AddUnitToAntinormal(uGRUNT, 19)
      call AddUnitToAntinormal(uKODO_BEAST, 1)
      call AddUnitToAntinormal(uTAUREN,10)
      call AddUnitToAntisiege(uHEAD_HUNTER,1)
      call AddUnitToAntisiege(uRAIDER,5)
      call AddUnitToAntisiege(uWYVERN,5)
      call AddUnitToAntimagic(uHEAD_HUNTER,1)
      call AddUnitToAntimagic(uRAIDER,5)
      call AddUnitToAntiunarmored(uHEAD_HUNTER,2)
      call AddUnitToAntiunarmored(uWYVERN,5)
      call AddUnitToAntiunarmored(uRAIDER,5)
      call AddUnitToAntilightarmor(uHEAD_HUNTER,3)
      call AddUnitToAntilightarmor(uWYVERN,1)
      call AddUnitToAntimediumarmor(uGRUNT,19)
      call AddUnitToAntimediumarmor(uKODO_BEAST,1)
      call AddUnitToAntiheavyarmor(uSHAMAN,15)
      call AddUnitToAntiheavyarmor(uWITCH_DOCTOR,2)
      call AddUnitToAntiheavyarmor(uSPIRIT_WALKER,3)
      call AddUnitToAntiheavyarmor(uWYVERN,5)
      call DynamicBuildUnit(64, 40)
      call BuildUnit(1, dragons[3], 65)
      call BuildUnit(1, merc_caster, 65)
    else
      call AddUnitToAntiair(uHEAD_HUNTER,1)
      call AddUnitToAntiair(uBATRIDER,1)
      call AddUnitToAntiair(uRAIDER,1)
      call AddUnitToAnticasters(uSPIRIT_WALKER,15)
      call AddUnitToAnticasters(uSHAMAN,5)
      call AddUnitToAntitowers(uCATAPULT,8)
      call AddUnitToAntitowers(uBATRIDER,1)
      call AddUnitToAntitowers(uRAIDER,1)
      call AddUnitToAntipiercing(uRAIDER, 1)
      call AddUnitToAntipiercing(uHEAD_HUNTER, 1)
      call AddUnitToAntinormal(uTAUREN, 19)
      call AddUnitToAntinormal(uKODO_BEAST, 1)
      call AddUnitToAntisiege(uHEAD_HUNTER,1)
      call AddUnitToAntisiege(uRAIDER,5)
      call AddUnitToAntisiege(uWYVERN,5)
      call AddUnitToAntimagic(uHEAD_HUNTER,1)
      call AddUnitToAntimagic(uRAIDER,5)
      call AddUnitToAntiunarmored(uHEAD_HUNTER,2)
      call AddUnitToAntiunarmored(uWYVERN,7)
      call AddUnitToAntiunarmored(uRAIDER,7)
      call AddUnitToAntilightarmor(uHEAD_HUNTER,1)
      call AddUnitToAntilightarmor(uWYVERN,1)
      call AddUnitToAntimediumarmor(uTAUREN,10)
      call AddUnitToAntimediumarmor(uKODO_BEAST,1)
      call AddUnitToAntiheavyarmor(uSHAMAN,15)
      call AddUnitToAntiheavyarmor(uWITCH_DOCTOR,2)
      call AddUnitToAntiheavyarmor(uSPIRIT_WALKER,3)
      call AddUnitToAntiheavyarmor(uWYVERN,5)
      call DynamicBuildUnit(100, 40)
      call BuildUnit(1, dragons[3], 65)
    endif

    // Global upgrades

      // TIER 1 UPGRADES
      //--------------------------------------------------------
		if tier == 1 then
		endif
	  	call BuildAdvUpgr2(3, uUPG_ORC_MELEE, 1,TownCountDone(uGRUNT) + TownCountDone(uTAUREN) + TownCountDone(uRAIDER), 5,15,35)
   		call BuildAdvUpgr2(3, uUPG_ORC_ARMOR, 1,TownCountDone(uGRUNT) + TownCountDone(uTAUREN) + TownCountDone(uRAIDER) + TownCountDone(uHEAD_HUNTER) + TownCountDone(uCATAPULT) + TownCountDone(uKODO_BEAST) + TownCountDone(uWYVERN) + TownCountDone(uBATRIDER), 5,15,35)
		call BuildAdvUpgr2(3, uUPG_ORC_RANGED, 1,TownCountDone(uHEAD_HUNTER) + TownCountDone(uCATAPULT) + TownCountDone(uKODO_BEAST) + TownCountDone(uWYVERN) + TownCountDone(uBATRIDER), 5,15,35)

	  
      // TIER 2 UPGRADES
      //--------------------------------------------------------
		if tier == 2 then
		endif
		if not (c_enemy_total == c_enemy[R_ELF]) then
			call BuildAdvUpgr(3, uUPG_ORC_SPIKES, 1, 1, 1, 10, 10)
		endif
		call BuildAdvUpgr2(1, uUPG_ORC_PILLAGE, 2,TownCountDone(uRAIDER) + TownCountDone(uGRUNT),0.5,15,50)
	  	call BuildAdvUpgr2(1, uUPG_ORC_WAR_DRUMS, 2,TownCountDone(uKODO_BEAST),0.25,10,50)
		call BuildAdvUpgr2(1, uUPG_ORC_ENSNARE, 2,TownCountDone(uRAIDER),0.33,15,70)
		call BuildAdvUpgr2(1, uUPG_ORC_REGEN, 2,TownCountDone(uHEAD_HUNTER)+TownCountDone(uBATRIDER),1,15,45)
		call BuildAdvUpgr2(2, uUPG_ORC_SHAMAN, 2,TownCountDone(uSHAMAN),0.33,15,80)
		call BuildAdvUpgr2(2, uUPG_ORC_DOCS, 2,TownCountDone(uWITCH_DOCTOR), 0.33,15,80)
		call BuildAdvUpgr2(2, uUPG_ORC_SWALKER, 2,TownCountDone(uSPIRIT_WALKER), 0.33,15,80)
		call BuildAdvUpgr2(2, uUPG_ORC_BERSERK, 2, TownCountDone(uGRUNT), 0.33,15,60)	  

      // TIER 3 UPGRADES
      //--------------------------------------------------------
		if tier == 3 then
		endif
		call BuildAdvUpgr2(1, uUPG_ORC_NAPTHA, 3,TownCountDone(uCATAPULT),0.25,15,50)
	 	if towerrush then
        		call BuildAdvUpgr(1, uUPG_ORC_BURROWS, 3,1,1,0,40)
	  	else
			call BuildAdvUpgr(1, uUPG_ORC_BURROWS, 3, 1,1,0,40)
		endif
		call BuildAdvUpgr2(1, uUPG_ORC_BERSERKER, 3,TownCountDone(uHEAD_HUNTER), 0.33,15,60)
        call BuildAdvUpgr2(1, uUPG_ORC_VENOM, 3,TownCountDone(uWYVERN),0.33,15,70)
		call BuildAdvUpgr2(1, uUPG_ORC_PULVERIZE, 3,TownCountDone(uTAUREN),0.25,15,60)
		call BuildAdvUpgr2(1, uUPG_ORC_FIRE, 3,TownCountDone(uBATRIDER),0.33,15,60)
		//call BuildAdvUpgr2(1, uUPG_ORC_WAR_DRUMS,3, TownCountDone(uKODO_BEAST),0.25,15,40)
	  


          // Global Mercenaries
          call BuildUnit(2, merc_healer, 70)

          // Harass
          call Harass(1, HARASS_TARGET_PEONS, true, 4, 0.75, 0, GetPlayerRace(nearest_enemy) != RACE_UNDEAD and TownCountDone(uGRUNT) > 4, 40, 80)
          call Harass(3, HARASS_TARGET_PEONS, true, 5, 0.85, 0, GetPlayerRace(nearest_enemy) != RACE_UNDEAD and TownCountDone(uWYVERN) > 4, 120, 160)
	  call Harass(4, HARASS_TARGET_PEONS, false, 12, 0.1, 0, hero[1] == uBLADE_MASTER and hero_skills[1] == HERO_SKILL_MINOR and not towerrush and GetPlayerRace(nearest_enemy) != RACE_UNDEAD, 36, 150)
























































endfunction

