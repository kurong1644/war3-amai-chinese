call BuildUnit(25, uWYVERN, 42)
call BuildUnit(1, hero[1], 80)
call BuildUnit(1, hero[2], 72)
call BuildUnit(1, uVOODOO_LOUNGE, 50)

      call BuildUpgr(1, uUPG_ORC_VENOM, 92)





















elseif tier == 2 then
call BuildUnit(18, uWYVERN, 40)
call BuildUnit(1, hero[1], 80)
call BuildUnit(1, hero[2], 72)
call BuildUnit(1, uFORTRESS, 62)
call BuildUnit(1, uVOODOO_LOUNGE, 50)























else

	call BuildFront(2, uORC_WATCH_TOWER, 44)
	call BuildUnit(1, hero[1], 80)
	call BuildUnit(10, uGRUNT, 40)
        call BuildUnit(1, uSTRONGHOLD, 75)






















endif
endfunction

function init_strategy_BarrackMix takes nothing returns nothing

    call AddHarass(2, 3, uGRUNT)
    call AddHarass(2, 4, uHEAD_HUNTER)
    call AddHarass(2, 1, uCATAPULT)
    set distraction_group = 2































endfunction
function build_sequence_BarrackMix takes nothing returns nothing
if tier == 3 then
      call SetBuildReact(55, 2, uGRUNT, 4, uHEAD_HUNTER, (enemy_unarmored + enemy_air - enemy_normal), 4, 25, 105)
      call SetBuildReact(30, 1, uGRUNT, 0, uCATAPULT, (enemy_unarmored + enemy_towers + enemy_casters)/2, 4, 25, 80)
      call BuildUnit(1, hero[1], 80)
      call BuildUnit(1, hero[2], 72)
      call BuildUnit(1, hero[3], 60)
      call BuildUpgr(Min(((TownCountDone(uGRUNT)/2)-2),1), uUPG_ORC_BERSERK, 70)
      call BuildUpgr(Min(((TownCountDone(uGRUNT)/2)-2),1), uUPG_ORC_PILLAGE, 50)
      call BuildUpgr(Min(((TownCountDone(uHEAD_HUNTER)/2)-2),1), uUPG_ORC_REGEN, 50)
      call BuildUpgr(Min(((TownCountDone(uGRUNT)/2)-1),3), uUPG_ORC_MELEE, 60)
      call BuildUpgr(Min(((TownCountDone(uHEAD_HUNTER)/2)-1),3), uUPG_ORC_RANGED, 60)
      call BuildUpgr(3, uUPG_ORC_ARMOR, 40)
      call BuildUnit(1, uVOODOO_LOUNGE, 50)
      if not (c_enemy_total == c_enemy[R_ELF]) then
        call BuildUpgr(3, uUPG_ORC_SPIKES, 20)
      endif


































elseif tier == 2 then

      call SetBuildReact(30, 1, uGRUNT, 4, uHEAD_HUNTER, (enemy_unarmored + enemy_air - enemy_normal), 4, 25, 80)
      call SetBuildReact(20, 1, uGRUNT, 0, uCATAPULT, (enemy_unarmored + enemy_towers + enemy_casters)/2, 4, 25, 70)
      call BuildUnit(1, hero[1], 80)
      call BuildUnit(1, hero[2], 72)
      call BuildUnit(1, uFORTRESS, 62)
      call BuildUpgr(Min(((TownCountDone(uGRUNT)/2)-2),1), uUPG_ORC_PILLAGE, 50)
      call BuildUpgr(Min(((TownCountDone(uHEAD_HUNTER)/2)-2),1), uUPG_ORC_REGEN, 50)
      call BuildUpgr(Min(((TownCountDone(uGRUNT)/2)-1),2), uUPG_ORC_MELEE, 60)
      call BuildUpgr(Min(((TownCountDone(uHEAD_HUNTER)/2)-1),2), uUPG_ORC_RANGED, 60)
      call BuildUpgr(2, uUPG_ORC_ARMOR, 30)
      call BuildUpgr(Min(((TownCountDone(uGRUNT)/2)-2),1), uUPG_ORC_BERSERK, 70)
      call BuildUnit(1, uVOODOO_LOUNGE, 50)
      if not (c_enemy_total == c_enemy[R_ELF]) then
        call BuildUpgr(2, uUPG_ORC_SPIKES, 10)
      endif


































else

      call BuildUpgr(Min(((TownCountDone(uGRUNT)/2)-2),1), uUPG_ORC_PILLAGE, 30)
      call SetBuildReact(30, 1, uGRUNT, 3, uHEAD_HUNTER, (enemy_unarmored + enemy_air - enemy_normal), 4, 16, 65)
      call BuildUnit(1, uVOODOO_LOUNGE, 55)
      call BuildUnit(1, hero[1], 130)
      call BuildUnit(1, uSTRONGHOLD, 75)
      if not (c_enemy_total == c_enemy[R_ELF]) then
        call BuildUpgr(1, uUPG_ORC_SPIKES, 10)
      endif

































endif
endfunction

function init_strategy_BestiaryMix takes nothing returns nothing

    call AddHarass(2, 3, uRAIDER)
    call AddHarass(2, 4, uWYVERN)
    call AddHarass(2, 1, uKODO_BEAST)
    set distraction_group = 2
























endfunction
function build_sequence_BestiaryMix takes nothing returns nothing
if tier == 3 then

      call SetBuildReact(20, 2, uWYVERN, 2, uBATRIDER, (enemy_towers + enemy_unarmored)/2, 4, 25, 70)
      call SetBuildReact(20, 2, uRAIDER, 2, uKODO_BEAST, enemy_heavyarmor - enemy_piercing, 4, 25, 70)
      call SetBuildReact(40, 2, uWYVERN, 2, uRAIDER, (enemy_unarmored + enemy_towers + enemy_casters + enemy_piercing)/4, 4, 25, 75)
      call BuildUnit(1, hero[1], 80)
      call BuildUnit(1, hero[2], 72)
      call BuildUnit(1, hero[3], 60)
      call BuildUpgr(Min(TownCountDone(uKODO_BEAST),1), uUPG_ORC_WAR_DRUMS, 70)
      call BuildUpgr(Min(((TownCountDone(uRAIDER)/2)-2),1), uUPG_ORC_PILLAGE, 50)
      call BuildUpgr(Min(((TownCountDone(uRAIDER)/2)-2),1), uUPG_ORC_ENSNARE, 50)
      call BuildUpgr(Min(((TownCountDone(uWYVERN)/2)-2),1), uUPG_ORC_VENOM, 50)
      call BuildUpgr(Min(((TownCountDone(uBATRIDER)/2)-2),1), uUPG_ORC_FIRE, 50)
      call BuildUpgr(Min(((TownCountDone(uRAIDER)/2)-1),3), uUPG_ORC_MELEE, 60)
      call BuildUpgr(Min(((TownCountDone(uWYVERN)/2)-1),3), uUPG_ORC_RANGED, 60)
      call BuildUpgr(3, uUPG_ORC_ARMOR, 40)
      call BuildUnit(1, uVOODOO_LOUNGE, 50)
      if not (c_enemy_total == c_enemy[R_ELF]) then
        call BuildUpgr(3, uUPG_ORC_SPIKES, 20)
      endif
























elseif tier == 2 then

      call SetBuildReact(20, 1, uWYVERN, 1, uBATRIDER, (enemy_towers + enemy_unarmored)/2, 4, 25, 70)
      call SetBuildReact(20, 1, uRAIDER, 1, uKODO_BEAST, enemy_heavyarmor - enemy_piercing, 4, 25, 70)
      call SetBuildReact(30, 1, uWYVERN, 1, uRAIDER, (enemy_unarmored + enemy_towers + enemy_casters + enemy_piercing)/4, 4, 25, 75)
      call BuildUnit(1, hero[1], 80)
      call BuildUnit(1, hero[2], 72)
      call BuildUnit(1, uFORTRESS, 62)
      call BuildUpgr(Min(((TownCountDone(uRAIDER)/2)-2),1), uUPG_ORC_PILLAGE, 50)
      call BuildUpgr(Min(((TownCountDone(uRAIDER)/2)-2),1), uUPG_ORC_ENSNARE, 20)
      call BuildUpgr(Min(((TownCountDone(uRAIDER)/2)-1),2), uUPG_ORC_MELEE, 60)
      call BuildUpgr(Min(((TownCountDone(uWYVERN)/2)-1),2), uUPG_ORC_RANGED, 60)
      call BuildUpgr(2, uUPG_ORC_ARMOR, 30)
      call BuildUnit(1, uVOODOO_LOUNGE, 50)
      if not (c_enemy_total == c_enemy[R_ELF]) then
        call BuildUpgr(2, uUPG_ORC_SPIKES, 10)
      endif
























else

      call BuildUpgr(Min(((TownCountDone(uRAIDER)/2)-2),1), uUPG_ORC_PILLAGE, 30)
      call BuildUnit(2, uORC_WATCH_TOWER, 60)
      call BuildUnit(1, uVOODOO_LOUNGE, 55)
      call BuildUnit(1, hero[1], 70)
      call BuildUnit(1, uSTRONGHOLD, 75)
      if not (c_enemy_total == c_enemy[R_ELF]) then
        call BuildUpgr(1, uUPG_ORC_SPIKES, 10)
      endif
























endif
endfunction


