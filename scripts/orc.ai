function init_strategy_HeadCatapults takes nothing returns nothing
    call AddBlock(1, uFORGE, false, 1, uBURROW, 60)
    call AddBlock(1, uORC_ALTAR, false, 1, uBURROW, 60)
    call AddBlock(1, uFORGE, false, 9, uPEON, 60)

    call AddHarass(2, 3, uHEAD_HUNTER)
    call AddHarass(2, 1, uCATAPULT)
    set distraction_group = 2


















endfunction
function build_sequence_HeadCatapults takes nothing returns nothing
if tier == 3 then

      call BuildUnit(3, merc_range, 70)
      call BuildUnit(16, uHEAD_HUNTER, 40)
      call BuildUnit(8, uCATAPULT, 56)
      call BuildUnit(1, hero[1], 80)
      call BuildUnit(1, hero[2], 72)
      call BuildUnit(1, hero[3], 60)
      call BuildUnit(1, uVOODOO_LOUNGE, 50)

      call BuildUpgr(1, uUPG_ORC_REGEN, 72)
      call BuildUpgr(1, uUPG_ORC_BERSERKER, 72)
      call BuildUpgr(1, uUPG_ORC_NAPTHA, 66)


















elseif tier == 2 then

      call BuildUnit(2, merc_range, 70)
      call BuildUnit(12, uHEAD_HUNTER, 50)
      call BuildUnit(5, uCATAPULT, 64)
      call BuildUnit(1, hero[1], 80)
      call BuildUnit(1, hero[2], 72)
      call BuildUnit(1, uFORTRESS, 62)
      call BuildUnit(1, uVOODOO_LOUNGE, 50)

      call BuildUpgr(1, uUPG_ORC_REGEN, 74)



















else

      call BuildUnit(1, merc_rush, 65)
      call BuildUnit(12, uHEAD_HUNTER, 38)
      call BuildUnit(2, uCATAPULT, 50)
      call BuildUnit(1, hero[1], 70)
      call BuildUnit(1, uSTRONGHOLD, 75)





















endif
endfunction

function init_strategy_Wyvern takes nothing returns nothing

    call AddHarass(2, 1, uWYVERN)
