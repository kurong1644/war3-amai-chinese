function build_sequence_VersusHuman takes nothing returns nothing
if tier == 3 then

	call BuildUnit(1, hero[1], 80)
	call BuildUnit(1, hero[2], 72)
	call BuildUnit(15, uRAIDER, 40)
	call BuildUnit(15, uSPIRIT_WALKER, 40)
	if enemy_air >= 10 then
		call BuildUnit(10, uBATRIDER, 40)
      		call BuildUpgr(1, uUPG_ORC_FIRE, 60)
	endif

      	call BuildUpgr(1, uUPG_ORC_ENSNARE, 70)





















elseif tier == 2 then

	call BuildUnit(1, hero[1], 80)
	call BuildUnit(1, hero[2], 72)
	call BuildUnit(10, uRAIDER, 50)
	call BuildUnit(10, uSPIRIT_WALKER, 40)
	if enemy_air >= 10 then
		call BuildUnit(10, uBATRIDER, 40)
	else
		call BuildUnit(15, uRAIDER, 40)
      		call BuildUpgr(1, uUPG_ORC_ENSNARE, 70)
	endif
        call BuildUnit(1, uFORTRESS, 62)

	call BuildUpgr(1, uUPG_ORC_SWALKER, 60)






















else

	call BuildUnit(1, hero[1], 80)
	call BuildUnit(10, uGRUNT, 40)
        call BuildUnit(1, uSTRONGHOLD, 75)






















endif
endfunction

