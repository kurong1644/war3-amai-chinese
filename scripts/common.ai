function GetGlobalHealingItem takes nothing returns integer
	if false then
	elseif own_race == R_ELF and (GetFloatGameState(GAME_STATE_TIME_OF_DAY) < 18 and GetFloatGameState(GAME_STATE_TIME_OF_DAY) > 6) and available_time[uMOONSTONE] <= ai_time then
		return uMOONSTONE
	endif
	return 0
endfunction

function GetHeroManaItem takes nothing returns integer
	if false then
	elseif own_race != R_UNDEAD and available_time[uLESSER_CLARITY_POTION] <= ai_time then
		return uLESSER_CLARITY_POTION
	elseif tier >= 2 and available_time[uMANA_POTION] <= ai_time then
		return uMANA_POTION
	endif
	return 0
endfunction

function GetItemHealingTime takes integer id returns integer
  if false then
  elseif uSCROLL_OF_REGENERATION == id then
    return 9
  elseif uMOONSTONE == id then
    return 6
  elseif uHEALING_SALVE == id then
    return 9
  elseif uLESSER_CLARITY_POTION == id then
    return 6
  elseif uRITUAL_DAGGER == id then
    return 45
  endif
  return 0
