function GetNeutralNumber takes integer id returns integer
  if buy_type[id] == BT_NEUTRAL_HERO then
    return NEUTRAL_TAVERN
  elseif buy_type[id] == BT_GOBLIN_MERC then
    return NEUTRAL_OBSERVATORY
  elseif buy_type[id] == BT_MERC then
    return NEUTRAL_MERC_CAMP
  else
    return NEUTRAL_DRAGON_ROOST
  endif
endfunction

function GetTQLock takes nothing returns nothing
  loop
    exitwhen tq_lock
    call Sleep(0.5)
  endloop
  set tq_lock = false
endfunction

function ReleaseTQLock takes nothing returns nothing
  set tq_lock = true
endfunction

function TQSleep takes real time returns nothing
  local integer i = 1
  call GetTQLock()
  loop
    exitwhen i > tq_length
    set tq_time[i] = tq_time[i] + time
    set i = i + 1
  endloop
  call ReleaseTQLock()
  call Sleep(time)
endfunction

function ActionListInit takes integer an returns nothing
  local integer i = 0
  set action_numbers = an
  loop
    exitwhen i >= an
    set action_points[i] = 0.0
    set i = i + 1
  endloop
endfunction

function ActionRule takes boolean b, integer chn, real cha returns nothing
  if b then
    set action_points[chn] = action_points[chn] + cha
  endif
endfunction

function ActionRule2 takes boolean b, integer chn, real cha, integer chn2, real cha2 returns nothing
  if b then
    set action_points[chn] = action_points[chn] + cha
    set action_points[chn2] = action_points[chn2] + cha2
  endif
endfunction

function ActionRule3 takes boolean b, integer chn, real cha, integer chn2, real cha2, integer chn3, real cha3 returns nothing
  if b then
    set action_points[chn] = action_points[chn] + cha
    set action_points[chn2] = action_points[chn2] + cha2
    set action_points[chn3] = action_points[chn3] + cha3
  endif
endfunction

function ActionListEval takes nothing returns integer
  local integer i = 0
  local integer max_i = -1
  local real max_val = -10000000.0
  loop
    exitwhen i >= action_numbers
    if action_points[i] > max_val then
      set max_i = i
      set max_val = action_points[i]
    endif
    set i = i + 1
  endloop
  return max_i
endfunction

function GetPlayerStrengthHandicap takes player p returns real
  return SquareRoot(GetPlayerHandicap(p))
endfunction

function GetPlayerHeroBonusStrength takes player p returns integer
  local integer strength = 0
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oARCHMAGE )
  set strength = strength + 1 * GetPlayerUnitTypeCount(p, oPALADIN )
  set strength = strength + 1 * GetPlayerUnitTypeCount(p, oMTN_KING )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oBLADE_MASTER )
  set strength = strength + 1 * GetPlayerUnitTypeCount(p, oFAR_SEER )
  set strength = strength + 1 * GetPlayerUnitTypeCount(p, oTAUREN_CHIEF )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oDEATH_KNIGHT )
  set strength = strength + 1 * GetPlayerUnitTypeCount(p, oLICH )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oDEMON_HUNTER )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oDEMON_HUNTER_M )
  set strength = strength + 1 * GetPlayerUnitTypeCount(p, oKEEPER )
  set strength = strength + 1 * GetPlayerUnitTypeCount(p, oWARDEN )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oNAGA_SORCERESS )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oBEAST_MASTER )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oBREW_MASTER )
  set strength = strength + 1 * GetPlayerUnitTypeCount(p, oGOBLIN_TINKER )
  set strength = strength + 1 * GetPlayerUnitTypeCount(p, oFIRELORD )
  return strength
endfunction
function GetHeroStrength takes unit u returns integer
  local integer lvl = GetHeroLevel(u)
  if GetOwningPlayer(u) != ai_player or not IsUnitInGroup(u, unit_healing) then
    if lvl >= ver_hero_ultimate_level then
      return R2I(ver_hero_base_value + lvl + ver_hero_ultimate_value + 0.5)
    else
      return R2I(ver_hero_base_value + lvl + 0.5)
    endif
  endif
  return 0
endfunction

function GetPlayerHeroStrengthMod takes player p returns integer
  local group g = CreateGroup()
  local unit u = null
  local integer sum = 0
  local real handicap = GetPlayerStrengthHandicap(p)
  call GroupEnumUnitsOfPlayer(g, p, null)
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    if IsUnitType(u, UNIT_TYPE_HERO) and UnitAlive(u) then
      set sum = sum + R2I(GetHeroStrength(u) * handicap * (GetUnitState(u, UNIT_STATE_LIFE) / RMax(GetUnitState(u, UNIT_STATE_MAX_LIFE),1)))
    endif
    call GroupRemoveUnit(g,u)
  endloop
  set sum = sum + GetPlayerHeroBonusStrength(p)
  call DestroyGroup(g)
  set g = null
  return sum 
endfunction

function GetUnitStrengthEx takes unit u returns integer
  if GetOwningPlayer(u) != Player(PLAYER_NEUTRAL_AGGRESSIVE) then
    if IsUnitType(u, UNIT_TYPE_HERO) then
      return GetHeroStrength(u)
    else
      return R2I((GetUnitFoodUsed(u) + GetUnitLevel(u)) / 2 + 0.5) // +0.5 for rounding , food used often matches the level but can be weaker or stronger forms of a lvl 2 unit so uses average
    endif
  else
      return R2I(GetUnitLevel(u) + 0.5) // Creeps entirely use the level in evaluating strength
  endif
  return 0
endfunction

function IsUnitTower takes unit u returns boolean
  local integer unitid = GetUnitTypeId(u)
  if unitid == oCANNON_TOWER then
    return true
  endif
  if unitid == oGUARD_TOWER then
    return true
  endif
  if unitid == oWATCH_TOWER then
    return true
  endif
  if unitid == oARCANE_TOWER then
    return true
  endif
  if unitid == oORC_WATCH_TOWER then
    return true
  endif
  if unitid == oZIGGURAT_1 then
    return true
  endif
  if unitid == oZIGGURAT_2 then
    return true
  endif
  if unitid == oZIGGURAT_FROST then
    return true
  endif
  if unitid == oANCIENT_PROTECT then
    return true
  endif
  if IsUnitType(u, UNIT_TYPE_STRUCTURE) and IsUnitType(u, UNIT_TYPE_RANGED_ATTACKER) then
    return true
  endif
  return false
endfunction

function GetUnitStrength takes unit u returns real
  if GetUnitState(u, UNIT_STATE_MAX_LIFE) == 0 then
    call DisplayToAll("ERROR: Major error has occured and caused amai system to crash at function GetUnitStrength")
    call DisplayToAll("Please contact the creator and provide this replay to them")
  endif
  if IsUnitTower(u) then
    return 3 * (GetUnitState(u, UNIT_STATE_LIFE) / GetUnitState(u, UNIT_STATE_MAX_LIFE)) // Towers can usually take out 2 footmen with ease so strength based on that
  endif
  if IsUnitType(u, UNIT_TYPE_ANCIENT) and IsUnitType(u, UNIT_TYPE_MELEE_ATTACKER) then // Passive as these can hit back with melee
    return 1 * (GetUnitState(u, UNIT_STATE_LIFE) / GetUnitState(u, UNIT_STATE_MAX_LIFE))
  endif
  return GetUnitStrengthEx(u) * GetPlayerStrengthHandicap(GetOwningPlayer(u)) * (GetUnitState(u, UNIT_STATE_LIFE) / GetUnitState(u, UNIT_STATE_MAX_LIFE))
endfunction

function GetPlayerStrength takes player p returns real

  local group g = CreateGroup()
  local unit u = null
  local real sum = 0

  call GroupEnumUnitsOfPlayer(g, p, null)
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    if not IsUnitType(u, UNIT_TYPE_HERO) and not IsUnitType(u, UNIT_TYPE_PEON) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and UnitAlive(u) and not IsUnitHidden(u) then
      //call Trace("A Unit strength added: " + Int2Str(R2I(GetUnitStrength(u))))
      set sum = sum + GetUnitStrength(u)
    endif
    call GroupRemoveUnit(g,u)
  endloop
  call DestroyGroup(g)
  set g = null
  //call Trace("A HERO strength added: " + Int2Str(GetPlayerHeroStrengthMod(p)))
  return sum + I2R(GetPlayerHeroStrengthMod(p))


endfunction

function GetUnexactPlayerStrength takes player p returns integer
  local integer pid = GetPlayerId(p)
  if p_str_cache_timeout[pid] < ai_time then
    if difficulty == HARD then
      set p_str_cache[pid] = Max(0,R2I(GetPlayerStrength(p)))
    else  
      set p_str_cache[pid] = Max(0, R2I(GetPlayerStrength(p) * GetRandomReal(1 - I2R(uncertainty) / 50, 1 + I2R(uncertainty) / 50)) + GetRandomDiff(uncertainty / 5))
    endif  
    set p_str_cache_timeout[pid] = ai_time + p_str_cache_valid_time
  endif
  return p_str_cache[pid]
endfunction

function GetMaximumEnemyStrength takes nothing returns integer
  local integer i = 0
  local integer max = 0
  local player p = null
  loop
    exitwhen i >= c_enemy_total
    set p = enemy_force[i]
    if GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING then
      set max = Max(max, R2I(GetPlayerStrength(p)))
    endif
    set i = i + 1
  endloop
  set p = null
  return max
endfunction

function GetPlayerairStrength takes player p returns real
  local real strength = 0
  set strength = strength + 1 * GetPlayerUnitTypeCount(p, oCOPTER )
  set strength = strength + 4 * GetPlayerUnitTypeCount(p, oGRYPHON )
  set strength = strength + 3 * GetPlayerUnitTypeCount(p, oHUMAN_DRAGON_HAWK )
  set strength = strength + 4 * GetPlayerUnitTypeCount(p, oWYVERN )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oBATRIDER )
  set strength = strength + 7 * GetPlayerUnitTypeCount(p, oFROST_WYRM )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oGARGOYLE )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oGARGOYLE_MORPH )
  set strength = strength + 5 * GetPlayerUnitTypeCount(p, oBLK_SPHINX )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oDRUID_TALON_M )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oHIPPO )
  set strength = strength + 4 * GetPlayerUnitTypeCount(p, oHIPPO_RIDER )
  set strength = strength + 5 * GetPlayerUnitTypeCount(p, oCHIMAERA )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oFAERIE_DRAGON )
  if ai_time >= 20 and ((40 >= 0 and ai_time <= 40) or 40 < 0) and GetPlayerUnitTypeCount(p, oSTRONGHOLD) >= 1 and GetPlayerUnitTypeCount(p, oBESTIARY) >= 1 then
    set strength = strength + 10
  endif
  if ai_time >= 20 and ((50 >= 0 and ai_time <= 50) or 50 < 0) and GetPlayerUnitTypeCount(p, oANCIENT_WIND) >= 1 and GetPlayerUnitTypeCount(p, oTREE_ETERNITY) >= 1 then
    set strength = strength + 10
  endif
  if ai_time >= 20 and ((40 >= 0 and ai_time <= 40) or 40 < 0) and GetPlayerUnitTypeCount(p, oAVIARY) >= 1 then
    set strength = strength + 10
  endif
  return strength
endfunction
function GetPlayercastersStrength takes player p returns real
  local real strength = 0
  set strength = strength + 1 * GetPlayerUnitTypeCount(p, oELEMENTAL )
  set strength = strength + 1 * GetPlayerUnitTypeCount(p, oELEMENTAL2 )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oELEMENTAL3 )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oPRIEST )
  set strength = strength + 2 * GetPlayerUnitTypeCount(p, oSORCERESS )
