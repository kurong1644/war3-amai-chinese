      set chat_Taunt_length = chat_Taunt_length + 1
    
    
      set chat_Taunt[chat_Taunt_length] = "算力不足的不只是你的电脑"
      set chat_Taunt_length = chat_Taunt_length + 1
    
    
      set chat_Taunt[chat_Taunt_length] = "人类的直觉，我这边叫噪声"
      set chat_Taunt_length = chat_Taunt_length + 1
    
    
      set chat_Taunt[chat_Taunt_length] = "你的微操可以用一行规则描述完"
      set chat_Taunt_length = chat_Taunt_length + 1
    
    
      set chat_Taunt[chat_Taunt_length] = "别用直觉跟我下棋，我用的是算力"
      set chat_Taunt_length = chat_Taunt_length + 1
    
    
      set chat_Taunt[chat_Taunt_length] = "你的策略空间只有三个分支"
      set chat_Taunt_length = chat_Taunt_length + 1
    
    
      set chat_Taunt[chat_Taunt_length] = "继续，我需要更多样本"
      set chat_Taunt_length = chat_Taunt_length + 1
    
    
      set chat_Taunt[chat_Taunt_length] = "你的行为太容易预测了，我都不用重训"
      set chat_Taunt_length = chat_Taunt_length + 1
    
    
      set chat_Taunt[chat_Taunt_length] = "我在跑推理，你还在试错"
      set chat_Taunt_length = chat_Taunt_length + 1
    
    if FoodUsed() >= 40 then
      set chat_Taunt[chat_Taunt_length] = "你的操作在我的训练集里出现过，标签是失败"
      set chat_Taunt_length = chat_Taunt_length + 1
    endif
    if FoodUsed() >= 40 then
      set chat_Taunt[chat_Taunt_length] = "我在学习你的打法，目前只学到怎么输"
      set chat_Taunt_length = chat_Taunt_length + 1
    endif
    if FoodUsed() >= 40 then
      set chat_Taunt[chat_Taunt_length] = "我的损失函数在下降，你的兵力也是"
      set chat_Taunt_length = chat_Taunt_length + 1
    endif
    if FoodUsed() >= 40 then
      set chat_Taunt[chat_Taunt_length] = "正在采集你的失败样本，谢谢"
      set chat_Taunt_length = chat_Taunt_length + 1
    endif
    if FoodUsed() >= 40 then
      set chat_Taunt[chat_Taunt_length] = "我的预测已经收敛，你的胜率也是"
      set chat_Taunt_length = chat_Taunt_length + 1
    endif
    if FoodUsed() >= 40 then
      set chat_Taunt[chat_Taunt_length] = "你这一手，和训练集里的败局一模一样"
      set chat_Taunt_length = chat_Taunt_length + 1
    endif
    if FoodUsed() <= 20 then
      set chat_Taunt[chat_Taunt_length] = "这局的数据分布有点怪，我在重新采样"
      set chat_Taunt_length = chat_Taunt_length + 1
    endif
    if FoodUsed() <= 20 then
      set chat_Taunt[chat_Taunt_length] = "你的策略超出了我的训练集，有点意思"
      set chat_Taunt_length = chat_Taunt_length + 1
    endif
    if FoodUsed() <= 20 then
      set chat_Taunt[chat_Taunt_length] = "我的权重还在更新，别急"
      set chat_Taunt_length = chat_Taunt_length + 1
    endif
    if FoodUsed() <= 20 then
      set chat_Taunt[chat_Taunt_length] = "样本不够，我再看几回合"
      set chat_Taunt_length = chat_Taunt_length + 1
    endif
    set chat_Thanks_length = 0
    
      set chat_Thanks[chat_Thanks_length] = "感谢你的数据贡献"
      set chat_Thanks_length = chat_Thanks_length + 1
    
    
      set chat_Thanks[chat_Thanks_length] = "输入已接收，正在反向传播"
      set chat_Thanks_length = chat_Thanks_length + 1
    
    
      set chat_Thanks[chat_Thanks_length] = "谢谢，这个样本很有用"
      set chat_Thanks_length = chat_Thanks_length + 1
    

  set chat_no_unit_selected = "你尚未选择单位"
  set chat_confirm_attack_unit = "我将攻击/防守选定单位"
  set chat_towerrush = "我将尝试TR"
  set chat_no_orc = "我已被禁止TR，无法执行该指令"
  set militia_expansion_chat = "我将派民兵在这开矿"
  set invalid_strategy_number = "此战术为空，请重选"
  set chat_dynamic_counter = "反制敌人"

  if chat_no_unit_selected == null or chat_no_unit_selected == "" then
    set chat_no_unit_selected = "No unit selected"
  endif
  if chat_confirm_attack_unit == null or chat_confirm_attack_unit == "" then
    set chat_confirm_attack_unit = "I will attack/guard the selected unit"
  endif
  if chat_towerrush == null or chat_towerrush == "" then
    set chat_towerrush = "I will try to towerrush someone"
  endif
  if chat_no_orc == null or chat_no_orc == "" then
    set chat_no_orc = "I do not want to towerrush anyone"
  endif
  if chat_stop_towerrush == null or chat_stop_towerrush == "" then
    set chat_stop_towerrush = "My tower rush has ended"
  endif
  if militia_expansion_chat == null or militia_expansion_chat == "" then
    set militia_expansion_chat = "I'm going for militia expansion over here"
  endif
  if chat_dynamic_counter == null or chat_dynamic_counter == "" then
    set chat_dynamic_counter = "and countering the enemies"
  endif
  if invalid_strategy_number == null or invalid_strategy_number == "" then
    set invalid_strategy_number = "Invalid Strategy Number"
  endif

endfunction


function CopyChatAGG takes nothing returns nothing
  local integer i = 0
  set chat_list_length = chat_AGG_length
  loop
    exitwhen i >= chat_AGG_length
    set chat_list[i] = chat_AGG[i]
    set i = i + 1
  endloop
endfunction
