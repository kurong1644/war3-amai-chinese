	if false then
	elseif own_race == R_ORC and available_time[uHEALING_SALVE] <= ai_time then
		return uHEALING_SALVE
	elseif own_race == R_UNDEAD and available_time[uRITUAL_DAGGER] <= ai_time then
		return uRITUAL_DAGGER
	endif
	return 0
endfunction

