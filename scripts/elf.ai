      call SetBuildReact(20, 10, uHUNTRESS, 0, uARCHER, enemy_air, 5, 20, 70)
      call BuildUnit(4, uDRYAD, 62)
      call BuildUnit(1, uTREE_ETERNITY, 62)
      call BuildUnit(1, hero[1], 80)
      call BuildUnit(1, hero[2], 72)
      call BuildUnit(1, uDEN_OF_WONDERS, 80)

      call BuildUpgr(1, uUPG_ABOLISH, 78)

























else

      call BuildUnit(1, merc_rush, 60)
      call SetBuildReact(22, 6, uHUNTRESS, 3, uARCHER, (enemy_unarmored + (enemy_lightarmor * 2) + enemy_air + enemy_magic - (enemy_normal * 2)), 3, 18, 60)
      call BuildUnit(1, uTREE_AGES, 75)
      call BuildUnit(1, hero[1], 70)


























endif
endfunction

