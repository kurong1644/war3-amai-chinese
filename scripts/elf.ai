function SetRaceAggression takes nothing returns nothing
  set b_race_aggression[0] = 1
  set b_race_aggression[1] = 3
  set b_race_aggression[2] = 5
  set b_race_aggression[3] = 0
  set b_race_aggression[4] = 1
  set b_race_aggression[5] = 2
  set b_race_aggression[6] = 0
  set b_race_aggression[7] = 1
  set b_race_aggression[8] = 2
  set b_race_aggression[9] = -2
  set b_race_aggression[10] = -1
  set b_race_aggression[11] = 0
endfunction

function AMAI_PickMeleeHero takes nothing returns nothing
  local integer i = 0
  //local location l = GetUnitLoc(nearest_neutral[NEUTRAL_TAVERN])

  set hero_number = race_hero_number + ver_neutral_hero_number
  // recalculate_heros occurs only if hero is a tavern hero but tavern is not pathable
  if not recalculate_heros and ver_neutral_heroes_available and neutral_available[NEUTRAL_TAVERN] then //and CanPathToLoc(home_location, l, PATHING_TYPE_WALKABILITY) > 0 then
    call InitNeutralSkills()
    //call Trace("PickMeleeHero: Neutral Hero possible")
  else
    set first_choosable_hero = ver_neutral_hero_number
  endif
  //call RemoveLocation(l)
  //set l = null

  set all_heroes[0] = uNAGA_SORCERESS
  set hero_rp[0] = 20
  set all_heroes[1] = uBEAST_MASTER
  set hero_rp[1] = 15
  set all_heroes[2] = uDARK_RANGER
  set hero_rp[2] = 19
  set all_heroes[3] = uNEUTRAL_PIT_LORD
  set hero_rp[3] = 10
  set all_heroes[4] = uBREW_MASTER
  set hero_rp[4] = 12
  set all_heroes[5] = uGOBLIN_TINKER
  set hero_rp[5] = 10
  set all_heroes[6] = uFIRELORD
  set hero_rp[6] = 19
  set all_heroes[7] = uALCHEMIST
  set hero_rp[7] = 10
  set all_heroes[8] = uDEMON_HUNTER
  set hero_rp[8] = 37
  set all_heroes[9] = uKEEPER
  set hero_rp[9] = 23
  set all_heroes[10] = uMOON_PRIESTESS
  set hero_rp[10] = 25
  set all_heroes[11] = uWARDEN
  set hero_rp[11] = 15


  loop
  exitwhen i > hero_number
    set all_heroes_copy[i] = all_heroes[i]
    set i = i + 1
  endloop

  call AddFavoriteHeroRP()
  call AddStrategyHeroRP(strategy_first_hero[strategy], strategy_first_hero_bonus[strategy])

  // increase the rp for those that are good for certain matchups

  if c_ally_total > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 0
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_enemy[R_RANDOM] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 0
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_enemy[R_ELF] > 0 then
    set hero_rp[0] = hero_rp[0] + 5
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 10
    set hero_rp[9] = hero_rp[9] + 5
    set hero_rp[10] = hero_rp[10] + 10
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_ally[R_ELF] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 0
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_enemy[R_HUMAN] > 0 then
    set hero_rp[0] = hero_rp[0] + 5
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 5
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 10
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_ally[R_HUMAN] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 0
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_enemy[R_ORC] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 10
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 5
    set hero_rp[6] = hero_rp[6] + 5
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 10
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_ally[R_ORC] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 0
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_enemy[R_UNDEAD] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 10
    set hero_rp[3] = hero_rp[3] + 0
    set hero_rp[4] = hero_rp[4] + 5
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 10
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif

  if c_ally[R_UNDEAD] > 0 then
    set hero_rp[0] = hero_rp[0] + 0
    set hero_rp[1] = hero_rp[1] + 0
    set hero_rp[2] = hero_rp[2] + 0
    set hero_rp[3] = hero_rp[3] + -8
    set hero_rp[4] = hero_rp[4] + 0
    set hero_rp[5] = hero_rp[5] + 0
    set hero_rp[6] = hero_rp[6] + 0
    set hero_rp[7] = hero_rp[7] + 0
    set hero_rp[8] = hero_rp[8] + 0
    set hero_rp[9] = hero_rp[9] + 0
    set hero_rp[10] = hero_rp[10] + 0
    set hero_rp[11] = hero_rp[11] + 0
  endif


  set hero_rp[0] = hero_rp[0] + -10
  set hero_rp[1] = hero_rp[1] + 0
  set hero_rp[2] = hero_rp[2] + -5
  set hero_rp[3] = hero_rp[3] + -2
  set hero_rp[4] = hero_rp[4] + -6
  set hero_rp[5] = hero_rp[5] + -1
  set hero_rp[6] = hero_rp[6] + -10
  set hero_rp[7] = hero_rp[7] + -3
  set hero_rp[8] = hero_rp[8] + 9
  set hero_rp[9] = hero_rp[9] + 0
  set hero_rp[10] = hero_rp[10] + 0
  set hero_rp[11] = hero_rp[11] + 0

  set picked_hero = ChooseFirstHero()

  set hero_rp[0] = hero_rp[0] - -10
  set hero_rp[1] = hero_rp[1] - 0
  set hero_rp[2] = hero_rp[2] - -5
  set hero_rp[3] = hero_rp[3] - -2
  set hero_rp[4] = hero_rp[4] - -6
  set hero_rp[5] = hero_rp[5] - -1
  set hero_rp[6] = hero_rp[6] - -10
  set hero_rp[7] = hero_rp[7] - -3
  set hero_rp[8] = hero_rp[8] - 9
  set hero_rp[9] = hero_rp[9] - 0
  set hero_rp[10] = hero_rp[10] - 0
  set hero_rp[11] = hero_rp[11] - 0


  // increase the rp for those that are better as second or third hero
  set hero_rp[0] = hero_rp[0] + 10
  set hero_rp[1] = hero_rp[1] + -4
  set hero_rp[2] = hero_rp[2] + 0
  set hero_rp[3] = hero_rp[3] + 0
  set hero_rp[4] = hero_rp[4] + 6
  set hero_rp[5] = hero_rp[5] + 0
  set hero_rp[6] = hero_rp[6] + 0
  set hero_rp[7] = hero_rp[7] + -1
  set hero_rp[8] = hero_rp[8] + 0
  set hero_rp[9] = hero_rp[9] + 0
  set hero_rp[10] = hero_rp[10] + 0
  set hero_rp[11] = hero_rp[11] + 0

  call AddStrategyHeroRP(strategy_second_hero[strategy], strategy_second_hero_bonus[strategy])
  call ChooseSecondHero()
  set hero_rp[0] = hero_rp[0] - 10
  set hero_rp[1] = hero_rp[1] - -4
  set hero_rp[2] = hero_rp[2] - 0
  set hero_rp[3] = hero_rp[3] - 0
  set hero_rp[4] = hero_rp[4] - 6
  set hero_rp[5] = hero_rp[5] - 0
  set hero_rp[6] = hero_rp[6] - 0
  set hero_rp[7] = hero_rp[7] - -1
  set hero_rp[8] = hero_rp[8] - 0
  set hero_rp[9] = hero_rp[9] - 0
  set hero_rp[10] = hero_rp[10] - 0
  set hero_rp[11] = hero_rp[11] - 0
  // ------------------------------------------------------------------------------

  set hero_rp[0] = hero_rp[0] + 0
  set hero_rp[1] = hero_rp[1] + -8
  set hero_rp[2] = hero_rp[2] + 0
  set hero_rp[3] = hero_rp[3] + 0
  set hero_rp[4] = hero_rp[4] + 9
  set hero_rp[5] = hero_rp[5] + 0
  set hero_rp[6] = hero_rp[6] + 0
  set hero_rp[7] = hero_rp[7] + 0
  set hero_rp[8] = hero_rp[8] + -28
  set hero_rp[9] = hero_rp[9] + 0
  set hero_rp[10] = hero_rp[10] + 0
  set hero_rp[11] = hero_rp[11] + 0

  call AddStrategyHeroRP(strategy_third_hero[strategy], strategy_third_hero_bonus[strategy])
  call ChooseRestHeroes()
endfunction






function airairBuild takes nothing returns nothing
  local integer cc_airair = 0

  set cc_airair = TownCount(uHIPPO)
  if cc_airair >= bn_airair then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_airair, uHIPPO, 90  )
  endif
endfunction
function airgroundBuild takes nothing returns nothing
  local integer cc_airground = 0

  set cc_airground = TownCount(uCHIMAERA)
  if cc_airground >= bn_airground then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_airground, uCHIMAERA, 90  )
  endif
endfunction
function groundairBuild takes nothing returns nothing
  local integer cc_groundair = 0

  set cc_groundair = TownCount(uARCHER)
  if cc_groundair >= bn_groundair then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_groundair, uARCHER, 90  )
  endif
endfunction
function groundgroundBuild takes nothing returns nothing
  local integer cc_groundground = 0

  set cc_groundground = TownCount(uHUNTRESS)
  if cc_groundground >= bn_groundground then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_groundground, uHUNTRESS, 90  )
  endif
endfunction
function farmBuild takes nothing returns nothing
  local integer cc_farm = 0

  set cc_farm = TownCount(uMOON_WELL)
  if cc_farm >= bn_farm then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_farm, uMOON_WELL, 90  )
  endif
endfunction
function guardBuild takes nothing returns nothing
  local integer cc_guard = 0

  set cc_guard = TownCount(uANCIENT_PROTECT)
  if cc_guard >= bn_guard then
    set strategy = chosen_strategy
  else
    call BuildUnit( bn_guard, uANCIENT_PROTECT, 90  )
  endif
endfunction

function cmdBuild takes nothing returns nothing
  if false then
  elseif strategy == 50 then
    call airairBuild()
  elseif strategy == 51 then
    call airgroundBuild()
  elseif strategy == 52 then
    call groundairBuild()
  elseif strategy == 53 then
    call groundgroundBuild()
  elseif strategy == 54 then
    call farmBuild()
  elseif strategy == 55 then
    call guardBuild()
  endif
endfunction

function set_skills takes nothing returns nothing
    if hero[1]== uNAGA_SORCERESS then
        call LoadSkills(1,1,1)
    elseif hero[2]== uNAGA_SORCERESS then
        call LoadSkills(2,1,2)
    elseif hero[3]== uNAGA_SORCERESS then
        call LoadSkills(3,1,3)
    endif
    if hero[1]== uBEAST_MASTER then
        call LoadSkills(1,2,1)
    elseif hero[2]== uBEAST_MASTER then
        call LoadSkills(2,2,2)
    elseif hero[3]== uBEAST_MASTER then
        call LoadSkills(3,2,3)
    endif
    if hero[1]== uDARK_RANGER then
        call LoadSkills(1,3,1)
    elseif hero[2]== uDARK_RANGER then
        call LoadSkills(2,3,2)
    elseif hero[3]== uDARK_RANGER then
        call LoadSkills(3,3,3)
    endif
    if hero[1]== uNEUTRAL_PIT_LORD then
        call LoadSkills(1,4,1)
    elseif hero[2]== uNEUTRAL_PIT_LORD then
        call LoadSkills(2,4,2)
    elseif hero[3]== uNEUTRAL_PIT_LORD then
        call LoadSkills(3,4,3)
    endif
    if hero[1]== uBREW_MASTER then
        call LoadSkills(1,5,1)
    elseif hero[2]== uBREW_MASTER then
        call LoadSkills(2,5,2)
    elseif hero[3]== uBREW_MASTER then
        call LoadSkills(3,5,3)
    endif
    if hero[1]== uGOBLIN_TINKER then
        call LoadSkills(1,6,1)
    elseif hero[2]== uGOBLIN_TINKER then
        call LoadSkills(2,6,2)
    elseif hero[3]== uGOBLIN_TINKER then
        call LoadSkills(3,6,3)
    endif
    if hero[1]== uFIRELORD then
        call LoadSkills(1,7,1)
    elseif hero[2]== uFIRELORD then
        call LoadSkills(2,7,2)
    elseif hero[3]== uFIRELORD then
        call LoadSkills(3,7,3)
    endif
    if hero[1]== uALCHEMIST then
        call LoadSkills(1,8,1)
    elseif hero[2]== uALCHEMIST then
        call LoadSkills(2,8,2)
    elseif hero[3]== uALCHEMIST then
        call LoadSkills(3,8,3)
    endif
    if hero[1]== uDEMON_HUNTER then
        call LoadSkills(1,9,1)
    elseif hero[2]== uDEMON_HUNTER then
        call LoadSkills(2,9,2)
    elseif hero[3]== uDEMON_HUNTER then
        call LoadSkills(3,9,3)
    endif
    if hero[1]== uKEEPER then
        call LoadSkills(1,10,1)
    elseif hero[2]== uKEEPER then
        call LoadSkills(2,10,2)
    elseif hero[3]== uKEEPER then
        call LoadSkills(3,10,3)
    endif
    if hero[1]== uMOON_PRIESTESS then
        call LoadSkills(1,11,1)
    elseif hero[2]== uMOON_PRIESTESS then
        call LoadSkills(2,11,2)
    elseif hero[3]== uMOON_PRIESTESS then
        call LoadSkills(3,11,3)
    endif
    if hero[1]== uWARDEN then
        call LoadSkills(1,12,1)
    elseif hero[2]== uWARDEN then
        call LoadSkills(2,12,2)
    elseif hero[3]== uWARDEN then
        call LoadSkills(3,12,3)
    endif
endfunction

function setup_force takes boolean inj returns nothing

    set wave = wave + 1

    call InitAssaultGroup()

    if inj then
      call RemoveInjuries()
    endif

    call SetMeleeGroupAM( hero[1] )
    call SetMeleeGroupAM( hero[2] )
    call SetMeleeGroupAM( hero[3] )
    call SetMeleeGroupAM( uARCHER )
    call SetMeleeGroupAM( uDRUID_TALON )
    call SetMeleeGroupAM( uDRUID_TALON_M )
    call SetMeleeGroupAM( uBALLISTA )
    call SetMeleeGroupAM( uDRUID_CLAW )
    call SetMeleeGroupAM( uDRUID_CLAW_M )
    call SetMeleeGroupAM( uDRYAD )
    call SetMeleeGroupAM( uHIPPO )
    call SetMeleeGroupAM( uHIPPO_RIDER )
    call SetMeleeGroupAM( uHUNTRESS )
    call SetMeleeGroupAM( uCHIMAERA )
    call SetMeleeGroupAM( uMOUNTAIN_GIANT )
    call SetMeleeGroupAM( uFAERIE_DRAGON )
    call SetMeleeGroupAM( uGOBLIN_TINKER_M )
    call SetMeleeGroupAM( uALCHEMIST_M1 )
    call SetMeleeGroupAM( uALCHEMIST_M2 )
    call SetMeleeGroupAM( uALCHEMIST_M3 )
    call AttackGroupAddNeutrals()
    call AttackGroupAddUnknown()

endfunction



function basic_melee takes integer food, integer prio returns nothing
    call FoodPoolAM(food, true, race_simple_melee, GetFoodUsed(old_id[race_simple_melee]), CanBuildUnit(race_advanced_melee), race_advanced_melee, GetFoodUsed(old_id[race_advanced_melee]), prio)
endfunction

function setup_ghouls takes nothing returns nothing
  local integer gn = TownCountDone(racial_ghoul)
  local integer wood = GetWood()

  if wave <= 2 then
    set harvesting_ghouls = 1
  //elseif wave==2 then
    //set attacking_ghouls = Max(6, gn - 2)
  //elseif wood < maximum_peon_wood then
    //set attacking_ghouls = gn - Max((gn - 4) - (4 * TownCountDone(neutral_shredder)), 0)
    //set harvesting_ghouls = Max(0,Min(10 - wood / minimum_peon_wood,c_ghoul_done))
    //set attacking_ghouls = gn - (havesting_ghouls - (4 * TownCountDone(neutral_shredder))
  //elseif wood > maximum_peon_wood and wood < minimum_peon_wood / 2 then
    //set attacking_ghouls = gn - Max(2 - (4 * TownCountDone(neutral_shredder)), 0)
  elseif wave <= 4 then
    set harvesting_ghouls = Max(1,Min(R2I(race_min_ghouls*LinearInterpolation(maximum_peon_wood, minimum_peon_wood, 1, 0, wood) + 0.5),gn) - (R2I(shredder_peon_count/2) * TownCountDone(neutral_shredder)))
  else
    set harvesting_ghouls = Max(1,Min(R2I(race_max_ghouls*LinearInterpolation(maximum_peon_wood, minimum_peon_wood, 1, 0, wood) + 0.5),gn) - (R2I(shredder_peon_count/2) * TownCountDone(neutral_shredder)))
  endif
  //set attacking_ghouls = gn - harvesting_ghouls
  //set attacking_ghouls = Min(Max(attacking_ghouls, 0), gn)
  //call Trace("Attacking Ghouls:" + Int2Str(gn - harvesting_ghouls))
  call Trace("Harvesting Ghouls:" + Int2Str(harvesting_ghouls))
endfunction

//============================================================================
//  global builds
//============================================================================
function global_init_strategy takes nothing returns nothing
    call SetTierBlock(1, 0.5, 30, false)
    call SetTierBlock(2, 0.5, 45, false)
    if not IsMapFlagSet(MAP_RANDOM_HERO) then
      call AddBlock(1, uELF_ALTAR, false, 0, uANCIENT_WAR, 16)
      call AddBlock(1, uELF_ALTAR, true, 0, uDEN_OF_WONDERS, 36)
      call AddBlock(1, uELF_ALTAR, false, 0, uMOON_WELL, 16)
    endif
    call AddBlock(1, uANCIENT_WAR, true, 0, uANCIENT_PROTECT, 36)
    call AddBlock(1, uANCIENT_WAR, false, 0, uHUNTERS_HALL, 20)
    call AddBlock(1, uANCIENT_WAR, true, 0, uDEN_OF_WONDERS, 36)
    call AddHarass(1, 2, uHUNTRESS)
    call AddHarass(3, 2, uFAERIE_DRAGON)
    call AddHarass(4, 1, uDEMON_HUNTER)



















































endfunction
function global_build_sequence takes nothing returns nothing
      if GetGold() > 800 then
            call BuildFront(2, uANCIENT_PROTECT, 35)
      endif
      if GetRushFactor() < 5000 or GetPlayerRace(nearest_enemy) == RACE_UNDEAD then
      call BuildFront(2, uANCIENT_PROTECT, 51)
      endif
      if HasExpanded() then
            call DefendTownsFrontDone(2, uANCIENT_PROTECT, 75)
            if GetGold() > 2000 then
                  call DefendTownsFrontDone(3, uANCIENT_PROTECT, 35)
                  if tier >= 2 and TownCount(uANCIENT_PROTECT) >= 4 and TownCount(uDEN_OF_WONDERS) < 2 then
                        call DefendTownsDone(1, uDEN_OF_WONDERS, 40)
                  endif
                  if TownCount(uMOON_WELL) >= 8 then
                        call DefendTownsDone(2, uMOON_WELL, 35)
                  endif    
            endif
      endif

      // Global Items
      call BuildItem(1, uM_SCROLL_OF_HEALING, 40)
      call BuildItem(1, uSCROLL_OF_PROTECTION, 30)
      call BuildItem(1, uPOTION_OF_LESSER_INVULNERBILITY, 70)
      call BuildItem(1, uMOONSTONE, 45)
      call BuildItem(1, uBOOTS_OF_SPEED, 50)
      if tier == 1 then
	call BuildItem(1, uM_TOWN_PORTAL, 100)
      endif
      if tier > 1 then
        call BuildItem(1, uHEALING_POTION, 70)
        call BuildItem(1, uTOWN_PORTAL, 150)
        call BuildItem(1, uSTAFF_OF_PRESERVATION, 40)
      endif

    // DYNAMIC
    call ResetDynamicSystem()
    if tier == 1 then
      call AddUnitToAntiair(uARCHER,29)
      call AddUnitToAnticasters(uARCHER,29)
      call AddUnitToAntitowers(uBALLISTA,29)
      call AddUnitToAntipiercing(uHUNTRESS, 15)
      call AddUnitToAntipiercing(uARCHER,15)
      call AddUnitToAntinormal(uARCHER,20)
      call AddUnitToAntinormal(uHUNTRESS,10)
      call AddUnitToAntisiege(uARCHER,29)
      call AddUnitToAntimagic(uARCHER,29)
      call AddUnitToAntiunarmored(uARCHER,29)
      call AddUnitToAntilightarmor(uARCHER,29)
      call AddUnitToAntimediumarmor(uHUNTRESS,29)
      call AddUnitToAntiheavyarmor(uHUNTRESS,29)
      call DynamicBuildUnit(33, 38)
      call BuildUnit(1, merc_range, 65)
      call BuildUnit(1, merc_stopper, 65)
    elseif tier == 2 then
      call AddUnitToAntiair(uARCHER,15)
      call AddUnitToAntiair(uHIPPO,10)
      call AddUnitToAntiair(uDRUID_TALON,1)
      call AddUnitToAntiair(uDRYAD,10)
      call AddUnitToAnticasters(uFAERIE_DRAGON,2)
      call AddUnitToAnticasters(uARCHER,1)
      call AddUnitToAnticasters(uMOUNTAIN_GIANT,2)
      call AddUnitToAnticasters(uDRYAD,8+GetUpgradeLevel(old_id[uUPG_ABOLISH]))
      call AddUnitToAntitowers(uBALLISTA,4)
      call AddUnitToAntitowers(uMOUNTAIN_GIANT,1)
      call AddUnitToAntipiercing(uARCHER,5)
      call AddUnitToAntipiercing(uMOUNTAIN_GIANT,2)
      call AddUnitToAntinormal(uARCHER, 1)
      call AddUnitToAntinormal(uHUNTRESS,3)
      call AddUnitToAntinormal(uMOUNTAIN_GIANT,1)
      call AddUnitToAntinormal(uDRUID_CLAW,5)
      call AddUnitToAntisiege(uARCHER,1)
      call AddUnitToAntisiege(uMOUNTAIN_GIANT,1)
      call AddUnitToAntimagic(uARCHER,1)
      call AddUnitToAntimagic(uMOUNTAIN_GIANT,1)
      call AddUnitToAntimagic(uDRYAD,3)
      call AddUnitToAntimagic(uFAERIE_DRAGON,1)
      call AddUnitToAntiunarmored(uARCHER,7)
      call AddUnitToAntiunarmored(uDRYAD,7)
      call AddUnitToAntiunarmored(uHIPPO_RIDER,1)
      call AddUnitToAntiunarmored(uBALLISTA,1)
      call AddUnitToAntilightarmor(uARCHER,4)
      call AddUnitToAntilightarmor(uDRYAD,4)
      call AddUnitToAntilightarmor(uHIPPO_RIDER,1)
      call AddUnitToAntimediumarmor(uHUNTRESS,7)
      call AddUnitToAntimediumarmor(uDRUID_CLAW,4)
      call AddUnitToAntiheavyarmor(uDRUID_TALON,1)
      call AddUnitToAntiheavyarmor(uDRUID_CLAW,5)
      call DynamicBuildUnit(64, 40)
      call BuildUnit(1, dragons[3], 65)
      call BuildUnit(1, merc_range, 65)
    else
      call AddUnitToAntiair(uARCHER,15)
      call AddUnitToAntiair(uHIPPO,10)
      call AddUnitToAntiair(uDRUID_TALON,1)
      call AddUnitToAntiair(uDRYAD,10)
      call AddUnitToAnticasters(uFAERIE_DRAGON,2)
      call AddUnitToAnticasters(uARCHER,1)
      call AddUnitToAnticasters(uMOUNTAIN_GIANT,2)
      call AddUnitToAnticasters(uDRYAD,9)
      call AddUnitToAntitowers(uBALLISTA,5)
      call AddUnitToAntitowers(uMOUNTAIN_GIANT,2)
      call AddUnitToAntitowers(uCHIMAERA,GetUpgradeLevel(old_id[uUPG_CHIM_ACID]))
      call AddUnitToAntipiercing(uDRUID_CLAW,3)
      call AddUnitToAntipiercing(uARCHER,5)
      call AddUnitToAntipiercing(uMOUNTAIN_GIANT,2)
      call AddUnitToAntinormal(uHUNTRESS,1)
      call AddUnitToAntinormal(uMOUNTAIN_GIANT,1)
      call AddUnitToAntinormal(uDRUID_CLAW,5)
      call AddUnitToAntisiege(uARCHER,1)
      call AddUnitToAntisiege(uMOUNTAIN_GIANT,1)
      call AddUnitToAntimagic(uARCHER,1)
      call AddUnitToAntimagic(uMOUNTAIN_GIANT,1)
      call AddUnitToAntimagic(uDRYAD,3)
      call AddUnitToAntimagic(uFAERIE_DRAGON,1)
      call AddUnitToAntiunarmored(uARCHER,4)
      call AddUnitToAntiunarmored(uDRYAD,4)
      call AddUnitToAntiunarmored(uHIPPO_RIDER,1)
      call AddUnitToAntiunarmored(uBALLISTA,1)
      call AddUnitToAntilightarmor(uARCHER,7)
      call AddUnitToAntilightarmor(uDRYAD,7)
      call AddUnitToAntilightarmor(uHIPPO_RIDER,1)
      call AddUnitToAntimediumarmor(uHUNTRESS,1)
      call AddUnitToAntimediumarmor(uDRUID_CLAW,8)
      call AddUnitToAntiheavyarmor(uDRUID_TALON,1)
      call AddUnitToAntiheavyarmor(uCHIMAERA,3)
      call AddUnitToAntiheavyarmor(uDRUID_CLAW,5)
      call DynamicBuildUnit(100, 40)
      call BuildUnit(1, dragons[3], 65)
    endif

    // GLOBAL UPGRADES
    //--------------------------------------------------------
    if TownCountDone(uARCHER) > 1 and TownCountDone(uHIPPO) > 1 then
		call BuildAdvUpgr2(1, uUPG_HIPPO_TAME, 2,R2I(TownCountDone(uARCHER) + TownCountDone(uHIPPO)/2),1,10,80)
    endif

    // TIER 1 UPGRADES
    //--------------------------------------------------------
    if tier == 1 then
	endif
    call BuildAdvUpgr2(1, uUPG_ULTRAVISION, 1, TownCountDone(uARCHER) + TownCountDone(uHUNTRESS), 5, 10, 20)
    	call BuildAdvUpgr2(3, uUPG_STR_MOON, 1,TownCountDone(uARCHER) + TownCountDone(uHUNTRESS) + TownCountDone(uHIPPO_RIDER),5,15,35)
    	call BuildAdvUpgr2(3, uUPG_MOON_ARMOR, 1,TownCountDone(uARCHER) + TownCountDone(uHUNTRESS) + TownCountDone(uHIPPO_RIDER),5,15,35)
    	call BuildAdvUpgr2(3, uUPG_STR_WILD, 1,TownCountDone(uDRYAD) + TownCountDone(uDRUID_CLAW) + TownCountDone(uMOUNTAIN_GIANT) + TownCountDone(uDRUID_TALON) + TownCountDone(uCHIMAERA) + TownCountDone(uFAERIE_DRAGON),5,15,35 )
    	call BuildAdvUpgr2(3, uUPG_HIDES, 1,TownCountDone(uDRYAD) + TownCountDone(uDRUID_CLAW) + TownCountDone(uMOUNTAIN_GIANT) + TownCountDone(uDRUID_TALON) + TownCountDone(uCHIMAERA) + TownCountDone(uFAERIE_DRAGON),5,15,35 )


    // TIER 2 UPGRADES
    //--------------------------------------------------------
    if tier >= 2 then
	call BuildUpgr(1, uUPG_BLESSING, 25)
    	if c_ally_total > 1 then
		call BuildUpgr(1, uUPG_WELL_SPRING,30)
	else
		call BuildUpgr(1, uUPG_WELL_SPRING,25)	
	endif
    endif  
	call BuildAdvUpgr2(1, uUPG_BOWS,2,TownCountDone(uARCHER),1,10,40)
	call BuildAdvUpgr2(1, uUPG_SCOUT, 2,TownCountDone(uHUNTRESS),1,10,25)
	call BuildAdvUpgr2(1, uUPG_BOLT, 2,TownCountDone(uBALLISTA),0.25,10,40)
	call BuildAdvUpgr2(1, uUPG_ABOLISH, 2, TownCountDone(uDRYAD),0.33,15,80)
	call BuildAdvUpgr2(2, uUPG_DRUID_CLAW, 2, TownCountDone(uDRUID_CLAW),0.33,15,80)	
	call BuildAdvUpgr2(2, uUPG_DRUID_TALON, 2, TownCountDone(uDRUID_TALON),0.33,15,80)


    // TIER 3 UPGRADES
    //--------------------------------------------------------
    if tier == 3 then
	endif
	call BuildAdvUpgr2(1, uUPG_MARKSMAN, 3,TownCountDone(uARCHER),0.5, 15,65)
	call BuildAdvUpgr2(1, uUPG_GLAIVE, 3,TownCountDone(uHUNTRESS),0.5,15,65)
	call BuildAdvUpgr2(1, uUPG_HARD_SKIN,3,TownCountDone(uMOUNTAIN_GIANT),0.25,15,65)
	call BuildAdvUpgr2(1, uUPG_RESIST_SKIN,3,TownCountDone(uMOUNTAIN_GIANT),0.25,15,50)
	call BuildAdvUpgr2(1, uUPG_CHIM_ACID,3, TownCountDone(uCHIMAERA),0.25,15,50)
	call BuildAdvUpgr2(1, uUPG_MARK_CLAW,3,TownCountDone(uDRUID_CLAW),1,10,70)
	call BuildAdvUpgr2(1, uUPG_MARK_TALON,3,TownCountDone(uDRUID_TALON),1,10, 30)

      // Global Mercenaries
      call BuildUnit(2, merc_healer, 50)
      call BuildUnit(1, uSHREDDER, 70)

      // Harassing
      call Harass(1, HARASS_TARGET_PEONS, true, 4, 0.75, 0, GetPlayerRace(nearest_enemy) != RACE_UNDEAD and TownCountDone(uHUNTRESS) > 6, 50, 80)
      call Harass(3, HARASS_TARGET_PEONS, true, 4, 0.75, 0, GetPlayerRace(nearest_enemy) != RACE_UNDEAD and TownCountDone(uFAERIE_DRAGON) > 2, 50, 80)
      call Harass(4, HARASS_TARGET_PEONS, true, 4, 0.1, 0, GetPlayerRace(nearest_enemy) != RACE_UNDEAD and GetUnitCountDone(old_id[uDEMON_HUNTER]) > 0, 50, 80)



















































endfunction

