function InitBuildings takes nothing returns nothing
  set building[0] = uANCIENT_LORE
  set building[1] = uANCIENT_WAR
  set building[2] = uANCIENT_WIND
  set building[3] = uTREE_AGES
  set building[4] = uTREE_ETERNITY
  set building[5] = uTREE_LIFE
  set building[6] = uANCIENT_PROTECT
  set building[7] = uELF_ALTAR
  set building[8] = uCHIMAERA_ROOST
  set building[9] = uHUNTERS_HALL
  set building[10] = uMOON_WELL
  set building[11] = uELF_MINE
  set building[12] = uDEN_OF_WONDERS
  set building_length = 13
endfunction

function initRacialUnits takes nothing returns nothing

    set racial_peon = uWISP
    set racial_altar = uELF_ALTAR
    set uracial_altar = uELF_ALTAR
    if difficulty != EASY then
      set racial_rushcreep = uANCIENT_WAR  // EASY build one , Impact Development
    endif

    set racial_hall[1] = uTREE_LIFE
    set uracial_hall[1] = uTREE_LIFE
    set racial_hall[2] = uTREE_AGES
    set uracial_hall[2] = uTREE_AGES
    set racial_hall[3] = uTREE_ETERNITY
    set uracial_hall[3] = uTREE_ETERNITY
    // Basically if its not a undead type expansion method just make variable the first hall
    if racial_expansion == 0 then
      set racial_expansion = racial_hall[1]
    endif

    set racial_goldmine[minearray] = 'egol'
    set minearray = minearray + 1
    set racial_goldmine[minearray] = 'ngol'
    set minearray = minearray + 1
    set gold_mines_ids[gold_mine_ids_size] = 'ugol'
    set gold_mine_ids_size = gold_mine_ids_size + 1
    set gold_mines_ids[gold_mine_ids_size] = 'egol'
    set gold_mine_ids_size = gold_mine_ids_size + 1
    set gold_mines_ids[gold_mine_ids_size] = 'ngol'
    set gold_mine_ids_size = gold_mine_ids_size + 1

    set racial_farm = uMOON_WELL
    if race_sell_ziggurats then
      set racial_zigg[ziggarray] = old_id[racial_farm]
      set ziggarray = ziggarray + 1
    endif

    set racial_shop = uDEN_OF_WONDERS
    set uracial_shop = uDEN_OF_WONDERS

endfunction

function initRacialTraits takes nothing returns nothing
  local integer i = 0

  set i = GetRandomInt(1, 100)
  set race_towerrush_available = (race_towerrush_available)
  if race_towerrush_available then
    call Trace("Towerrush variable is true")
  endif

endfunction

