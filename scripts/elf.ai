  set kb_add2 = 9
  set kb_add3 = 3
  set kb_add4 = 10
  set ku_add1 = 4
  set ku_add2 = 7
  set ku_add3 = 8
  set fav_unit_add = 20
  set debug_strategy = -1
  set race_use_fountain = true
  set race_manual_loading = true
  set race_manual_loading_wisp = uWISP
  set race_manual_loading_mine = uELF_MINE
  set race_towerrush_available = false
  set race_tower_id = uANCIENT_PROTECT
  set race_tower_upgrade = 0
  set race_towerrush_probability = 23
  set race_militia_expansion_available = false
  set race_hero_number = 4
  set race_simple_melee = uARCHER
  set race_advanced_melee = uDRUID_CLAW
  set race_has_ghouls = false
  set race_ghouls_attack = true
  set race_has_power_build = false
  set race_no_wood_harvest = false
  set race_ignore_injured = false
  set race_uses_mine_expansion = false
  set race_uses_shredder = true
  set race_militia_available = false
  set race_militia_max_distance = 1000
  set race_militia_id = 0
  set race_militia_ability = 0
  set race_militia_hall_ability = 0
  set race_militia_unitstring = ""
  set race_militiaworker_unitstring = ""
  set use_militia_only_on_bigger_threats = false
  set race_ancient_expansion_available = true
  set race_ancient_expansion_probability = 43
  set race_ancient_expansion_strength = 18
  set race_ancient_expansion_help_id = 'earc'
  set race_item_expansion_available = false
  set race_item_expansion_probability = 35
  set race_item_sale_level = 0
  set race_item_expansion_item_id = 0
  set race_sell_ziggurats = false
  set race_ziggurat_keep_distance = 1500
  set race_build_farms_front = true
  set race_farms_front_limit = 1
  set race_farms_at_mine = 0
  set race_max_expa_mine_distance = 850
  set race_has_moonwells = true
  set race_towerrush_hero_rush_level = 1
  set race_ancient_expansion_hero_rush_level = 1
  set ghoul_prio = 250
  set race_min_ghouls = 2
  set race_max_ghouls = 5
  set groundid = 'uaco'
  set race_ancient_barracks_rush_chance = 50
  set racial_burrow = 0
  set race_tower_upgrade2 = 0
  set race_tower_id_replace = 0
  set race_tower_move = true
  set race_tower_bypeon = true
  set race_tower_peon = 6
  set race_tower_item = 0
  set race_tower_item_must = false
  set race_tower_item_quantity = 0
  set rand = GetRandomInt(1, 100)
  //call DisplayToAll("elf chance:" + Int2Str(rand))
   if rand > race_ancient_barracks_rush_chance then
    set br_rush_built = true // This disables the rush this time
  endif
  call Trace("About to init things")
  call initRacialTraits()
  call Trace("racial traits init done")
  call InitStrats()
  call Trace("init strats")
  call InitAllSkills()
  call Trace("init all skills")
  call InitBuildings()
  call Trace("init buildings")
  call InitAMAI()
  call Trace("init AMAI")
  call InitProfile()
  call TraceN("About to choose strategy", 3)
  call chooseStrategyRP()
  call SmallMapsAdd()
  call removeNonBeginningStrats()
  call display_rp_strat()
  set chosen_counter = DetermineCounterForce()
   if debugging > 0 then
    //set debugcountertag = CreateTextTag()
    call UpdateDebugTextTag(debugcountertag, "Counter:" + strengthtext[chosen_counter], 18, GetLocationX(home_location) - 600, GetLocationY(home_location) - 600)
    call SetTextTagPermanent(debugcountertag, true)
  endif
  set chosen_strategy = choose_strategy()

  set strategy = chosen_strategy
  call SetChatVar("Strategy", GetCurrentStrategyName())
  if debugging > 0 then
    //set debugstrattag = CreateTextTag()
    call UpdateDebugTextTag(debugstrattag, "Strat:" + GetCurrentStrategyName(), 18, GetLocationX(home_location) - 300, GetLocationY(home_location) - 300)
    call SetTextTagPermanent(debugstrattag, true)
  endif
  call Trace("Strategy chosen")
  call AMAI_PickMeleeHero()
  call TraceN("Hero picked", 3)
  call set_skills()
  call TraceN("hero skills set", 3)
  call SetRaceAggression()
  call init_strategy()
  call Trace("Strategy init")
  call AMAI(function SkillArraysAM, function build_sequence_all, function attack_sequence_all)
  call Trace("Playing Game")
  call InitPlayerChatAM()
  call PlayGameAM()


endfunction
