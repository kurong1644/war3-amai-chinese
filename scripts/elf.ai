      call BuildUnit(3, uARCHER, 40)
      call BuildUnit(2, uFAERIE_DRAGON, 42)
      call BuildUnit(2, uBALLISTA, 42)
      call BuildUnit(1, uTREE_ETERNITY, 62)
      call BuildUnit(1, hero[1], 80)
      call BuildUnit(1, hero[2], 72)
